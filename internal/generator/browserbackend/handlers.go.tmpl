{{end}}// forwardedRequestHeaders is the allow list of the browser request headers that the API proxy sends to the API,
// each at most one time; it sends no other browser header (ST-SUP-RC02-OC07). It holds the headers of content and
// cache, and the request headers of the STEGO API contract: Idempotency-Key of a command (ST-SUP-RC32), and
// Authz-Revocation-After and Prefer of a read after a write (ST-SUP-RP11-LC21). The proxy sends Prefer only as the
// one preference wait=N that preferWait gives, and drops each other preference.
var forwardedRequestHeaders=[...]string{"Accept","Content-Type","If-Match","If-None-Match","Idempotency-Key","Authz-Revocation-After","Prefer"}
// maxWait is the longest wait for a revocation, in seconds, that a read through the proxy asks for: one second less
// than the request timeout of the proxy client, so the API answers before the proxy stops the request.
const maxWait=int((client.RequestTimeout-time.Second)/time.Second)
// MaxWaitingReads is the most requests with Authz-Revocation-After, reads and writes, that wait at one time. They
// hold their slot for up to maxWait seconds, so they get a pool of their own, and they can never take every slot of
// the proxy client from the other requests.
const MaxWaitingReads=4
// MaxWaitsPerSession is the most slots of the wait pool of one API that one session holds at one time, so that one
// session that sends requests in a loop on a pending revocation cannot take the pool of the other users (security
// review of PR #440, L2).
const MaxWaitsPerSession=1
// revocationLocation is the only form of Authz-Revocation-Location that the proxy returns: the path of a
// revocation with its identity, which the browser gives back in Authz-Revocation-After.
var revocationLocation=regexp.MustCompile(`^/authz/revocations/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
// preferWait gives the one preference that the proxy sends: wait=N of the first wait preference of the browser, at
// most maxWait, re-encoded. A read that waits for a revocation and gives no valid wait gets wait=maxWait. Each other
// preference is dropped.
func preferWait(prefer string,waiting bool)string{
 for _,preference:=range strings.Split(prefer,","){
  token,_,_:=strings.Cut(preference,";")
  name,seconds,ok:=strings.Cut(strings.TrimSpace(token),"=")
  if !ok||!strings.EqualFold(strings.TrimSpace(name),"wait"){continue}
  n,err:=strconv.Atoi(strings.Trim(strings.TrimSpace(seconds),`"`))
  if err!=nil||n<0{break}
  return "wait="+strconv.Itoa(min(n,maxWait))
