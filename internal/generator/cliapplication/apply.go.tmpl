// ApplyResource binds a manifest kind to a collection with the generated REST
// shape: resource objects have id; list objects have items, and next while the list has more pages.
// Named resources use metadata.name and PATCH. ImmutableIdentity enables
// immutable resources whose lookup uses required string fields from spec.
// Such resources have no PATCH fields; metadata.name is an optional output label.
// An absent apiVersion is accepted for existing files. A supplied version must match.
// IdempotentWrites states that the service keeps the Idempotency-Key of the create and the patch of the resource,
// as for a Command. ConditionalPatch states that the patch takes If-Match with the generation of the resource, which
// apply then sends as it read it (ST-SUP-RC04-OC38). A field with no flag is a secret member, writeOnly or
// x-sensitive, which only a private apply file gives, as only a private --body FILE gives it to a command
// (ST-SUP-RC04-OC32).
type ApplyResource struct {Kind,APIVersion,Path string;ImmutableIdentity []string;CreateFields,PatchFields []Field;IdempotentWrites,ConditionalPatch bool}
type applyPlan struct {resource ApplyResource;name,id,method,path,generation string;body map[string]json.RawMessage;payload []byte}
// NotCompared names the secret fields that apply left out of the write of a resource that exists, and never a value
// (ST-SUP-RC04-OC35).
type ApplyResult struct {Kind string `json:"kind"`;Name string `json:"name,omitempty"`;ID string `json:"id,omitempty"`;Status string `json:"status"`;NotCompared []string `json:"secrets_not_compared,omitempty"`}

// applyNameWarning is the warning of apply --help: a service that does not hold the name of a kind unique cannot refuse
// a second create of one name, so two clients that apply one new name at the same time can make two resources
// (ST-SUP-RC04-OC36).
// applySecretNote is the note of apply --help on a secret field, which the service never answers (ST-SUP-RC04-OC35).
const applySecretNote="A secret field of a resource that exists is not sent and is reported as not compared, as the stored value can differ; --set-secret FIELD sends it from a private file, and only a field that the document holds."
// secretOptions refuses a --set-secret that names no secret field of the patch of an apply resource, before any
// request.
func secretOptions(app Application,setSecret map[string]bool)error{
 for key:=range setSecret{
  found:=false;for _,r:=range app.Resources{for _,f:=range r.PatchFields{if f.Key==key&&f.Flag==""{found=true}}}
  if !found{return fmt.Errorf("--set-secret %s names no secret field that a patch of apply takes",key)}
 }
 return nil
}
const applyNameWarning="Two clients that apply one new name at the same time can make two resources, unless the service holds the name unique (unique: true on the field name)."
func validateApply(resources []ApplyResource)error{
 if len(resources)>64{return errors.New("too many apply resource definitions")}
 seen:=map[string]bool{}
 for _,r:=range resources{
  if !property.MatchString(r.Kind)||seen[r.Kind]||len(r.APIVersion)>128||!utf8.ValidString(r.APIVersion)||strings.ContainsAny(r.APIVersion,"\x00\r\n\t "){return errors.New("invalid apply resource definition")};seen[r.Kind]=true
  fields:=map[string]Field{}
  for _,set:=range [][]Field{r.CreateFields,r.PatchFields}{
   var flagged,secret []Field;for _,f:=range set{if f.Flag==""{secret=append(secret,f)}else{flagged=append(flagged,f)}}
   app:=Application{ConfigEnv:"APPLY_CONFIG",ConfigName:"apply",Commands:[]Command{ {Name:[]string{"resource"},Method:"POST",Path:r.Path,Fields:flagged,BodyFields:secret,Success:[]int{201}}}}
   if err:=validate(app);err!=nil{return err};hasName:=false
   for _,f:=range set{if previous,ok:=fields[f.Key];ok&&previous.Type!=f.Type{return errors.New("inconsistent apply field type")};fields[f.Key]=f;if f.Key=="name"&&f.Type=="string"{hasName=true};if f.Key=="id"{return errors.New("apply IDs belong in metadata")}}
   if !hasName&&len(r.ImmutableIdentity)==0{return errors.New("apply resources require a name field")}
  }
  if err:=validateImmutableApply(r);err!=nil{return err}
  if r.ConditionalPatch&&len(r.ImmutableIdentity)>0{return errors.New("invalid apply resource definition")}
 }
 return nil
}
func applyFields(fields []Field,body map[string]json.RawMessage,required bool)error{
 allowed:=map[string]Field{};for _,f:=range fields{allowed[f.Key]=f;if required&&f.Required{if _,ok:=body[f.Key];!ok{return fmt.Errorf("the required apply field %s is missing",f.Key)}}}
 for key,value:=range body{f,ok:=allowed[key];if !ok||!fieldValue(f,value){return errors.New("invalid apply field")}}
 return nil
}
// leaveSecrets leaves out of the write of a found resource each secret field of the document, a field with no flag,
// and gives the names of those fields, sorted. The service never answers a secret field, so apply cannot compare it
// with the stored value, and no read of the value is offered: apply thus never sends it again on its own, and a
// document with a required secret is applied again with no change of the secret. A secret field that setSecret names
// is kept in the patch, so the resource gets the value of the document; such a field that only the create takes is
// refused before any write, with its name and no value (ST-SUP-RC04-OC35; walkthrough 24, CLI-S).
func leaveSecrets(p *applyPlan,setSecret map[string]bool)([]string,error){
 patch:=map[string]bool{};for _,f:=range p.resource.PatchFields{if f.Flag==""{patch[f.Key]=true}}
 var left []string
 for _,set:=range [][]Field{p.resource.CreateFields,p.resource.PatchFields}{
  for _,f:=range set{
   if _,given:=p.body[f.Key];f.Flag!=""||!given{continue}
   if setSecret[f.Key]{if !patch[f.Key]{return nil,fmt.Errorf("apply cannot set the secret field %s of %s %q: only a create sets it, and the resource exists",f.Key,p.resource.Kind,p.name)};continue}
   delete(p.body,f.Key);left=append(left,f.Key)
  }
 }
 slices.Sort(left);return slices.Compact(left),nil
}
// keepCreateOnly leaves out of the patch of a found resource each field that only its create takes, such as a field
// with writable create: a document that gives the stored value is applied again, as kubectl apply leaves out an
// immutable field that did not change. A value that is not the stored one, or a field that the answer does not give,
// is refused before any write, with the name of the field (ST-SUP-RC04-OC35).
func keepCreateOnly(p *applyPlan,row map[string]json.RawMessage)error{
 patch:=map[string]bool{};for _,f:=range p.resource.PatchFields{patch[f.Key]=true}
 for _,f:=range p.resource.CreateFields{
  value,given:=p.body[f.Key];if !given||patch[f.Key]{continue}
  stored,ok:=row[f.Key]
  if !ok{return fmt.Errorf("apply cannot change the field %s of %s %q: only a create sets it, and the service does not return it, so apply cannot compare it; leave it out of the document",f.Key,p.resource.Kind,p.name)}
  if !sameApplyValue(f,value,stored){return fmt.Errorf("apply cannot change the field %s of %s %q: only a create sets it, and the resource has another value; give the stored value or leave the field out",f.Key,p.resource.Kind,p.name)}
  delete(p.body,f.Key)
 }
 return nil
}
// storedPatch tells whether each field of the patch of a found resource has the value that the service returned for
// it. Then apply sends no patch and reports unchanged, as kubectl apply does; a field that the answer does not give,
// or whose type apply cannot compare, sends the patch (ST-SUP-RC04-OC35; walkthrough 18). It compares with the resource
// as the lookup read it: a change of another writer after the read is not seen (ST-SUP-RC04-OC38).
func storedPatch(p *applyPlan,row map[string]json.RawMessage)bool{
 fields:=map[string]Field{};for _,f:=range p.resource.PatchFields{fields[f.Key]=f}
 for key,value:=range p.body{f,ok:=fields[key];stored,given:=row[key];if !ok||!given||!sameApplyValue(f,value,stored){return false}}
 return true
}
// sameApplyValue tells whether a value of a document is the value that the service returned for the field: the same
// text, number, truth value or list, or both null.
func sameApplyValue(f Field,given,stored json.RawMessage)bool{
 null:=func(raw json.RawMessage)bool{return bytes.Equal(bytes.TrimSpace(raw),[]byte("null"))}
 if null(given)||null(stored){return null(given)&&null(stored)}
 switch f.Type{
 case "integer":
  number:=func(raw json.RawMessage)(string,bool){var n json.Number;d:=json.NewDecoder(bytes.NewReader(raw));d.UseNumber();if d.Decode(&n)!=nil{var text string;if json.Unmarshal(raw,&text)!=nil{return "",false};n=json.Number(text)};i,err:=n.Int64();return strconv.FormatInt(i,10),err==nil}
  a,okA:=number(given);b,okB:=number(stored);return okA&&okB&&a==b
 case "string":var a,b string;return json.Unmarshal(given,&a)==nil&&json.Unmarshal(stored,&b)==nil&&a==b
 case "boolean":var a,b bool;return json.Unmarshal(given,&a)==nil&&json.Unmarshal(stored,&b)==nil&&a==b
 case "string-list":var a,b []string;return json.Unmarshal(given,&a)==nil&&json.Unmarshal(stored,&b)==nil&&slices.Equal(a,b)
 }
 return false
}
// sameDocument tells whether a resource that a lookup found after a create was answered 409 has the value of each
// field of the document (ST-SUP-RC04-OC36).
func sameDocument(p *applyPlan,row map[string]json.RawMessage)bool{
 fields:=map[string]Field{};for _,f:=range p.resource.CreateFields{fields[f.Key]=f}
 for key,value:=range p.body{f,ok:=fields[key];stored,given:=row[key];if !ok||!given||!sameApplyValue(f,value,stored){return false}}
 return true
}
// readGeneration gives the generation of a found resource as the text of a strong entity tag, such as "3", for the
// If-Match of its patch (ST-SUP-RC04-OC38).
func readGeneration(p *applyPlan,row map[string]json.RawMessage)error{
 var n json.Number;d:=json.NewDecoder(bytes.NewReader(row["generation"]));d.UseNumber()
 if d.Decode(&n)!=nil{return fmt.Errorf("%s %q: the service does not return the generation of the resource, which its patch needs in If-Match",p.resource.Kind,p.name)}
 value,err:=n.Int64();if err!=nil||value<0{return fmt.Errorf("%s %q: the service does not return the generation of the resource, which its patch needs in If-Match",p.resource.Kind,p.name)}
 p.generation=`"`+strconv.FormatInt(value,10)+`"`;return nil
}
// errApplySecretFile refuses an apply file that holds a secret field and that is not private: the effective user
// owns it and it permits no group or other access, as a --body FILE with a secret field (ST-SUP-RC04-OC32).
var errApplySecretFile=errors.New("an apply file that holds a secret field must be your own file and must not permit access by other users")
// privateSecrets refuses each plan whose document gives a secret field, a field with no flag, from a file that is
// not private. Standard input holds no file that another user can read. It runs before any request.
func privateSecrets(plans []applyPlan,private []bool)error{
 for i,p:=range plans{
  if i<len(private)&&private[i]{continue}
  for _,set:=range [][]Field{p.resource.CreateFields,p.resource.PatchFields}{for _,f:=range set{if _,ok:=p.body[f.Key];ok&&f.Flag==""{return errApplySecretFile}}}
 }
 return nil
}
func prepareApply(app Application,documents []map[string]json.RawMessage)([]applyPlan,error){
 definitions:=map[string]ApplyResource{};for _,r:=range app.Resources{definitions[r.Kind]=r}
 seen:=map[string]bool{};plans:=make([]applyPlan,0,len(documents))
 for _,document:=range documents{
  for key:=range document{switch key{case "apiVersion","kind","metadata","spec":default:return nil,errApplyInput}}
  var kind,version string
  if json.Unmarshal(document["kind"],&kind)!=nil{return nil,errApplyInput};r,ok:=definitions[kind];if !ok{return nil,errors.New("unsupported apply kind")}
  if raw,ok:=document["apiVersion"];ok{if bytes.Equal(raw,[]byte("null"))||json.Unmarshal(raw,&version)!=nil||version==""||version!=r.APIVersion{return nil,errors.New("unsupported apply API version")}}
  metadata,err:=object(document["metadata"]);if err!=nil{return nil,errApplyInput}
  var name,id string
  for key:=range metadata{switch key{case "name","id","description":default:return nil,errApplyInput}}
  if raw,ok:=metadata["name"];ok{if json.Unmarshal(raw,&name)!=nil||strings.TrimSpace(name)==""||!fieldValue(Field{Type:"string"},raw){return nil,errApplyInput}}else if len(r.ImmutableIdentity)==0{return nil,errApplyInput}
  if raw,ok:=metadata["id"];ok{if json.Unmarshal(raw,&id)!=nil||!identifier.MatchString(id){return nil,errApplyInput}}
  body:=map[string]json.RawMessage{}
  if raw,ok:=document["spec"];ok{body,err=object(raw);if err!=nil{return nil,errApplyInput}}
  for key,value:=range metadata{if key=="id"||(key=="name"&&len(r.ImmutableIdentity)>0){continue};if _,ok:=body[key];ok{return nil,errors.New("apply field occurs in both metadata and spec")};body[key]=value}
  // Check the union now. After lookup, check the selected operation before any write.
  for key,value:=range body{
   valid:=false;for _,set:=range [][]Field{r.CreateFields,r.PatchFields}{for _,f:=range set{if f.Key==key&&fieldValue(f,value){valid=true}}};if !valid{return nil,errors.New("invalid apply field")}
  }
  key:=r.Path+"\x00name\x00"+name
  if len(r.ImmutableIdentity)>0{values,err:=immutableIdentity(r,body);if err!=nil{return nil,err};encoded,_:=json.Marshal(values);key=r.Path+"\x00identity\x00"+string(encoded)}
  if id!=""{key=r.Path+"\x00id\x00"+id};if seen[key]{return nil,errors.New("duplicate apply resource")};seen[key]=true
  plans=append(plans,applyPlan{resource:r,name:name,id:id,body:body})
 }
 return plans,nil
}
// documentSecrets refuses, before any request, a --set-secret FIELD that no document of the apply holds: it would send
// nothing, and the caller would take the secret as set (security review of PR #493, L4). It names the field and no
// value.
func documentSecrets(plans []applyPlan,setSecret map[string]bool)error{
 for key:=range setSecret{
  held:=false;for _,p:=range plans{if _,given:=p.body[key];given{held=true}}
  if !held{return fmt.Errorf("--set-secret %s names a field that no apply document holds",key)}
 }
 return nil
}
// applyOptions reads the options of apply. Each --set-secret FIELD names a secret field that apply gives to a resource
// that exists; the option can come more than once.
func applyOptions(args []string)(filename,format,outputFile string,dry bool,setSecret map[string]bool,err error){
 seen:=map[string]bool{};setSecret=map[string]bool{}
 for i:=0;i<len(args);i++{
  key,value,has:=strings.Cut(args[i],"=")
  switch key{case "-f","--filename":key="filename";case "-o","--output":key="output";case "--output-file":key="output-file";case "--dry-run":key="dry-run";case "--set-secret":key="set-secret";case "-k","--kustomize":return "","","",false,nil,errors.New("kustomize input is not supported; supply rendered files with -f");default:return "","","",false,nil,errArguments}
  if seen[key]&&key!="set-secret"{return "","","",false,nil,errArguments};seen[key]=true
  if key=="dry-run"{if !has{value="true"};if value!="true"&&value!="false"{return "","","",false,nil,errArguments};dry=value=="true";continue}
  if !has{if i+1==len(args){return "","","",false,nil,errArguments};i++;value=args[i]};if value==""{return "","","",false,nil,errArguments}
  switch key{case "set-secret":if !property.MatchString(value){return "","","",false,nil,errArguments};setSecret[value]=true;case "filename":filename=value;case "output":format=value;case "output-file":outputFile=value}
 }
 if filename==""||(format!=""&&format!="json"){return "","","",false,nil,errArguments};return
}
func writeApply(destination *reservedOutput,format string,results []ApplyResult)error{
 var data []byte
 if format=="json"{var err error;data,err=json.MarshalIndent(results,"","  ");if err!=nil{return err};data=append(data,'\n')}else{
  var output bytes.Buffer;for _,r:=range results{fmt.Fprintf(&output,"%s/%q %s",r.Kind,r.Name,r.Status);if len(r.NotCompared)>0{fmt.Fprintf(&output," (secret fields not compared; the stored value can differ: %s)",strings.Join(r.NotCompared,", "))};output.WriteString("\n")};data=output.Bytes()
 }
 return destination.write(data)
}
func runApply(ctx context.Context,app Application,args []string,output io.Writer)error{
 ctx,cancel:=context.WithTimeout(ctx,5*time.Minute);defer cancel()
 if len(app.Resources)==0{return errors.New("apply is not configured")}
 if len(args)==1&&args[0]=="--help"{_,err:=fmt.Fprintln(output,"apply -f FILE|DIRECTORY|- [--dry-run] [--set-secret FIELD]... [-o json] [--output-file FILE]\n"+applyNameWarning+"\n"+applySecretNote);return err}
 filename,format,outputFile,dry,setSecret,err:=applyOptions(args);if err!=nil{return err}
 if err:=secretOptions(app,setSecret);err!=nil{return err}
 documents,private,err:=loadApply(ctx,filename);if err!=nil{return err}
 plans,err:=prepareApply(app,documents);if err!=nil{return err}
 if err:=privateSecrets(plans,private);err!=nil{return err}
 if err:=documentSecrets(plans,setSecret);err!=nil{return err}
 destination,err:=reserveOutput(outputFile,output);if err!=nil{return err};defer destination.close()
 results:=make([]ApplyResult,len(plans));for i,p:=range plans{results[i]=ApplyResult{Kind:p.resource.Kind,Name:p.name,ID:p.id,Status:"not_attempted"}}
 if dry{for i:=range results{results[i].Status="validated"};return writeApply(destination,format,results)}
 cfg,token,err:=requestCredentials(ctx,app);if err!=nil{return err}
 transport,err:=client.New(client.Options{BaseURL:cfg.URL,CAFile:cfg.CAFile,Timeout:15*time.Second});if err!=nil{return err};defer transport.Close()
 headers:=http.Header{"Authorization":{"Bearer "+token},"Accept":{"application/json"}}
 // Each lookup waits for the revocation of the last write of this configuration, so the list shows a row that the
 // write made (ST-SUP-RC04-OC37).
 revocation:=newLookupRevocation(app,cfg)
 targets:=map[string]bool{}
 for i:=range plans{
  p:=&plans[i]
  row,err:=applyLookup(ctx,transport,headers,p,revocation);if err!=nil{return err}
  if row!=nil{if json.Unmarshal(row["id"],&p.id)!=nil{return errors.New("invalid apply resource identity")}}
  p.path=p.resource.Path;p.method="POST";fields:=p.resource.CreateFields
  if p.id!=""{
   p.path+="/"+url.PathEscape(p.id)
   if targets[p.path]{return errors.New("multiple apply documents select the same resource")};targets[p.path]=true
   p.method="PATCH";fields=p.resource.PatchFields
   if len(p.resource.ImmutableIdentity)==0{if results[i].NotCompared,err=leaveSecrets(p,setSecret);err!=nil{return err}}
   if len(p.resource.ImmutableIdentity)>0{p.method="UNCHANGED";fields=p.resource.CreateFields}else if err:=keepCreateOnly(p,row);err!=nil{return err}else if storedPatch(p,row){p.method="UNCHANGED"}else if p.resource.ConditionalPatch{if err:=readGeneration(p,row);err!=nil{return err}}
  }
  if err:=applyFields(fields,p.body,true);err!=nil{return fmt.Errorf("%s %q: %w",p.resource.Kind,p.name,err)}
  p.payload,err=json.Marshal(p.body);if err!=nil||len(p.payload)>65536{return errApplyInput};results[i].ID=p.id
 }
 headers.Set("Content-Type","application/json")
 for i,p:=range plans{
  if err:=ctx.Err();err!=nil{if outErr:=writeApply(destination,format,results);outErr!=nil{return outErr};return err}
  if p.method=="UNCHANGED"{results[i].Status="unchanged";continue}
  request:=headers;if p.generation!=""{request=headers.Clone();request.Set("If-Match",p.generation)}
  response,retried,requestErr:=send(ctx,p.resource.IdempotentWrites,transport,p.method,p.path,request,p.payload)
  outcomeErr:=requestErr;results[i].Status="unknown"
  if requestErr==nil{
   // After a second request, the first one can still be in its transaction (409 in progress), so an answer that is
   // not a success leaves the outcome unknown (ST-SUP-RC04-OC25).
   if !retried&&p.method=="POST"&&response.StatusCode==409{
    // The unique key of the identity refused the create: look the resource up again, and send no other write for
    // it (ST-SUP-RC04-OC27, ST-SUP-RC04-OC36).
    row,lookupErr:=applyLookup(ctx,transport,headers,&p,revocation)
    if lookupErr==nil&&row!=nil&&(len(p.resource.ImmutableIdentity)>0||sameDocument(&p,row)){var id string;if json.Unmarshal(row["id"],&id)==nil{results[i].ID=id;results[i].Status="unchanged";continue}}
    if len(p.resource.ImmutableIdentity)==0&&lookupErr==nil{
     results[i].Status="failed";reason:="the lookup does not find it by its name, as for a resource that you may not read or of another unique value"
     if row!=nil{reason="the resource of this name has other values; apply again to patch it"}
     outcomeErr=fmt.Errorf("%s %q: a resource with a unique value of this document exists, and %s (HTTP 409)",p.resource.Kind,p.name,reason)
     if err:=writeApply(destination,format,results);err!=nil{return err};return fmt.Errorf("apply stopped at document %d; earlier writes remain: %w",i+1,outcomeErr)
    }
   }
   success:=response.StatusCode==200||(p.method=="POST"&&response.StatusCode==201)
   if success{revocation.keep(ctx,response)}
   if !success&&!retried&&p.method=="PATCH"&&p.generation!=""&&response.StatusCode==412{results[i].Status="failed";outcomeErr=fmt.Errorf("%s %q: the resource changed after apply read it; apply again (HTTP 412)",p.resource.Kind,p.name)}else if !success{if !retried&&response.StatusCode>=400&&response.StatusCode<500{results[i].Status="failed"};outcomeErr=fmt.Errorf("apply request failed (HTTP %d)%s",response.StatusCode,problemFacts(response))}else{
    row,decodeErr:=object(response.Body);var id,name string
    valid:=decodeErr==nil&&json.Unmarshal(row["id"],&id)==nil&&identifier.MatchString(id)&&(p.id==""||p.id==id)
    if len(p.resource.ImmutableIdentity)>0{valid=valid&&immutableMatches(&p,row)==nil}else{valid=valid&&json.Unmarshal(row["name"],&name)==nil&&name==p.name}
    if !valid{outcomeErr=errors.New("invalid apply write response; retrieve the resource before retry") }else{
     results[i].ID=id;results[i].Status="created";if p.method=="PATCH"{results[i].Status="configured"}
    }
   }
  }
  if outcomeErr!=nil{if err:=writeApply(destination,format,results);err!=nil{return err};return fmt.Errorf("apply stopped at document %d; earlier writes remain; an unknown result requires retrieval before retry: %w",i+1,outcomeErr)}
 }
 return writeApply(destination,format,results)
}
