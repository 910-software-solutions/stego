package {{.Package}}

import (
 "bytes"
 "encoding/base64"
 "encoding/json"
 "errors"
)

const maxSessionKeys=3
var errSessionKeys=errors.New("browser session keys require one to three distinct 256-bit keys")

// keyFault is a refusal of the session key file (ST-SUP-RC02-OC59): its class, one of file, size, encoding,
// document, count and duplicate, which the failure record names with the object and a fixed remedy. It holds no
// byte of the file. errors.Is(fault, errSessionKeys) is true.
type keyFault struct{ class string }

func (f *keyFault) Error() string { return "browser session keys: " + f.class }
func (f *keyFault) Is(target error) bool { return target == errSessionKeys }

// FaultClass, FaultObject and FaultRemedy give the class, the setting and the fixed text that tells the operator
// how to write the file, which the failure record names (ST-SUP-RC02-OC59).
func (f *keyFault) FaultClass() string { return f.class }
func (f *keyFault) FaultObject() string { return "stego_browser_session_key_file" }
func (f *keyFault) FaultRemedy() string { return sessionKeyRemedy }

// sessionKeyRemedy tells how to write the file of STEGO_BROWSER_SESSION_KEY_FILE: printable ASCII on one line.
const sessionKeyRemedy = "write the file of STEGO_BROWSER_SESSION_KEY_FILE as one key, the standard base64 of 32 random bytes on one line (the output of: openssl rand -base64 32), not the raw bytes; or as {\"version\":1,\"keys\":[...]} with one to three distinct such keys, the first of which encrypts; make it readable by the service user only"

func keyFaultOf(class string) error { return &keyFault{class: class} }

// The first key encrypts new records. All keys can decrypt stored records.
// Read the key file at startup. Keep its contents out of error messages.
func sessionKeys(raw []byte)(keys [][]byte,err error){
 defer func(){if err!=nil{for _,key:=range keys{clear(key)};keys=nil}}()
 if len(raw)>1024{return nil,keyFaultOf("size")};raw=bytes.TrimSpace(raw);if len(raw)==0{return nil,keyFaultOf("size")}
 encoded:=[]string{string(raw)}
 if raw[0]=='{'{
  if !validJSON(raw){return nil,keyFaultOf("document")}
  var fields map[string]json.RawMessage
  if json.Unmarshal(raw,&fields)!=nil||len(fields)!=2||string(fields["version"])!="1"{return nil,keyFaultOf("document")}
  if json.Unmarshal(fields["keys"],&encoded)!=nil{return nil,keyFaultOf("document")}
 }
 if len(encoded)<1||len(encoded)>maxSessionKeys{return nil,keyFaultOf("count")}
 seen:=map[[32]byte]bool{}
 for _,text:=range encoded{
  key,decodeErr:=base64.StdEncoding.Strict().DecodeString(text)
  if decodeErr!=nil||len(key)!=32||base64.StdEncoding.EncodeToString(key)!=text{clear(key);return keys,keyFaultOf("encoding")}
  identity:=[32]byte(key);if seen[identity]{clear(key);return keys,keyFaultOf("duplicate")};seen[identity]=true;keys=append(keys,key)
 }
 return keys,nil
}
