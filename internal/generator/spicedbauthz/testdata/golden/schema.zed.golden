definition user {}

// The operators who resolve a parked outbox message (ST-SUP-RC29-OC20).
definition outbox_destination {
	relation operator: user
	permission resolve = operator
}

definition service_account {}

definition document {
	relation owner: user
	relation viewer: user
	permission view = owner + viewer
	permission edit = owner
}

definition project {
	relation owner: user
	permission view = owner
	permission edit = owner
}

definition service {
	relation operator: user
	relation creator: user
	permission provision = operator
	permission retire = operator
	permission create = creator
}

definition stego_floor {
	relation marker: stego_floor
}
