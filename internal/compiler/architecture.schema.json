{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stego:architecture/1",
  "title": "STEGO architecture model",
  "description": "The architecture model that stego apply writes as architecture/architecture.json (ST-GEN-RM04). Version 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record",
    "system",
    "aspects",
    "layers",
    "containers",
    "components",
    "mixins",
    "ports",
    "bindings",
    "slots",
    "fills",
    "entities",
    "references",
    "collections",
    "operations",
    "actions",
    "flows",
    "needs",
    "boundaries",
    "settings",
    "authn_points",
    "authz_points",
    "access",
    "compliance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "const": ".stego/state.yaml"
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "archetype",
        "archetype_version",
        "language",
        "base_path",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "archetype": {
          "type": "string",
          "minLength": 1
        },
        "archetype_version": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "base_path": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "aspects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structure",
        "data_model",
        "request_flows",
        "platform_edges",
        "trust_and_tenancy"
      ],
      "properties": {
        "structure": {
          "$ref": "#/$defs/aspect"
        },
        "data_model": {
          "$ref": "#/$defs/aspect"
        },
        "request_flows": {
          "$ref": "#/$defs/aspect"
        },
        "platform_edges": {
          "$ref": "#/$defs/aspect"
        },
        "trust_and_tenancy": {
          "$ref": "#/$defs/aspect"
        }
      }
    },
    "layers": {
      "const": [
        "edge",
        "authentication",
        "handler",
        "slot",
        "repository",
        "store",
        "outside call"
      ]
    },
    "containers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/container"
      }
    },
    "actors": {
      "description": "The actors outside the service that an input states (ST-GEN-UC08-R01, R03). Every compiler since the context change writes it; a model without it is a model of an older compiler.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor"
      }
    },
    "relations": {
      "description": "The relations of the service container with the actors and the other containers, each with its source. Written with actors.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "mixins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mixin"
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/port"
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "slots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slot"
      }
    },
    "fills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fill"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/collection"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flow"
      }
    },
    "needs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/need"
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/variable"
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/boundary"
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/setting"
      }
    },
    "authn_points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "authz_points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/point"
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks",
        "permissions",
        "roles",
        "roles_complete"
      ],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/permission"
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/role"
          }
        },
        "roles_complete": {
          "type": "boolean"
        },
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "compliance": {
      "type": "array",
      "minItems": 7,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/topic"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z_]+:[^\\s]+$"
    },
    "source": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "declaration": {
          "type": "string",
          "minLength": 1
        },
        "wiring": {
          "type": "string",
          "minLength": 1
        },
        "default": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "part",
            "name",
            "version"
          ],
          "properties": {
            "part": {
              "enum": [
                "component",
                "archetype",
                "mixin"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "field": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "aspect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "present",
            "empty"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "empty"
          }
        }
      },
      "then": {
        "required": [
          "state",
          "reason"
        ]
      },
      "else": {
        "not": {
          "required": [
            "reason"
          ]
        }
      }
    },
    "layer": {
      "enum": [
        "edge",
        "authentication",
        "handler",
        "slot",
        "repository",
        "store",
        "outside call"
      ]
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "service",
            "backing store",
            "topic"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "caller",
            "token issuer",
            "authorization service",
            "outside system",
            "store"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "stated_by": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "text",
        "mode",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "through": {
          "$ref": "#/$defs/id"
        },
        "mode": {
          "enum": [
            "sync",
            "async"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "stage",
        "layer",
        "flow_part",
        "namespace",
        "container",
        "ports",
        "offers",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "$ref": "#/$defs/layer"
        },
        "flow_part": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "namespace": {
          "type": "string"
        },
        "container": {
          "$ref": "#/$defs/id"
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "port",
              "direction",
              "side"
            ],
            "properties": {
              "port": {
                "$ref": "#/$defs/id"
              },
              "direction": {
                "enum": [
                  "provides",
                  "requires"
                ]
              },
              "side": {
                "enum": [
                  "inbound",
                  "outbound"
                ]
              }
            }
          }
        },
        "offers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/offer"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "phase",
        "operations"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "$ref": "#/$defs/phase"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "create",
              "read",
              "update",
              "delete",
              "list",
              "upsert",
              "patch"
            ]
          }
        }
      }
    },
    "phase": {
      "enum": [
        "before_store",
        "after_store"
      ]
    },
    "mixin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "offers",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "offers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/offer"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "provided_by",
        "required_by",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "provided_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "required_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "port",
        "provider",
        "consumer",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "port": {
          "$ref": "#/$defs/id"
        },
        "provider": {
          "$ref": "#/$defs/id"
        },
        "consumer": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "collection",
        "name",
        "phase",
        "operations",
        "strategy",
        "short_circuit",
        "offered_by",
        "fills",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "collection": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "$ref": "#/$defs/phase"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "create",
              "read",
              "update",
              "delete",
              "list",
              "upsert",
              "patch"
            ]
          }
        },
        "strategy": {
          "enum": [
            "gate",
            "chain",
            "fan-out"
          ]
        },
        "short_circuit": {
          "type": "boolean"
        },
        "offered_by": {
          "$ref": "#/$defs/id"
        },
        "fills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "fill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "implements",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "implements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "tenant_kind",
        "fields",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tenant_kind": {
          "enum": [
            "owned",
            "shared",
            "system"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "resource_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "required",
        "sensitivity",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "sensitivity": {
          "enum": [
            "public",
            "pii",
            "secret"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "ref": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "field",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "field": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "relation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "entity",
        "operations",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "entity": {
          "$ref": "#/$defs/id"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "scope": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "collection",
        "verb",
        "flow",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "collection": {
          "$ref": "#/$defs/id"
        },
        "verb": {
          "enum": [
            "create",
            "read",
            "update",
            "delete",
            "list",
            "upsert",
            "patch"
          ]
        },
        "flow": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "fills",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "command",
            "query",
            "worker"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "fills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n",
        "kind",
        "element",
        "text",
        "mode",
        "source"
      ],
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "operation",
            "authenticate",
            "authorize",
            "handle",
            "slot",
            "repository",
            "store",
            "outbox",
            "event",
            "outside call"
          ]
        },
        "element": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "sync",
            "async"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "via_port": {
          "$ref": "#/$defs/id"
        },
        "layer": {
          "description": "The layer of the step, which the deriver sets. Written by every compiler since the context change.",
          "$ref": "#/$defs/layer"
        }
      }
    },
    "exit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after_step",
        "when",
        "result",
        "source"
      ],
      "properties": {
        "after_step": {
          "type": "integer",
          "minimum": 1
        },
        "when": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
