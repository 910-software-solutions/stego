# The offline Containerfile of the service. stego apply writes this file from the declaration. Do not edit it.
# The build stage downloads no module: with the module proxy off, it reads only the Go modules at
# /cachi2/output/deps/gomod/pkg/mod, where the Go module prefetch of Konflux puts them (prefetch-input gomod).
# The build holds them to go.sum (-mod=readonly), and go mod verify checks the module cache. This file does not
# turn off the network: build it in the hermetic mode of Konflux, or locally with --network=none. For a local
# build, mount a copy of the module cache folder that stego build download wrote at that path, writable,
# because go extracts the modules from it.
# The build has the settings and the arguments of stego build, with the Go SDK that it pins, so the executable is
# the one that the build record names. The image is scratch with the executable and the CA certificates, and it
# runs as the user 65532:65532: it writes no file, so it runs with a read-only root file system and an
# emptyDir at /tmp, as the Kubernetes base sets them.
FROM docker.io/library/golang:1.26.11-trixie@sha256:fa340cb59ebeb1d53ac1cccfc334201d938fe5f3458003cccb767096d8e032b8 AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY out/ ./out/
COPY fills/ ./fills/
RUN env -i \
    'CGO_ENABLED=0' \
    'GIT_CONFIG_COUNT=0' \
    'GIT_CONFIG_GLOBAL=/dev/null' \
    'GIT_CONFIG_NOSYSTEM=1' \
    'GIT_NO_REPLACE_OBJECTS=1' \
    'GIT_TERMINAL_PROMPT=0' \
    'GOAMD64=v1' \
    'GOARCH=amd64' \
    'GOAUTH=off' \
    'GOCACHE=/tmp/go-cache' \
    'GOCACHEPROG=' \
    'GOENV=off' \
    'GOEXPERIMENT=' \
    'GOFIPS140=off' \
    'GOFLAGS=' \
    'GOINSECURE=' \
    'GOMAXPROCS=2' \
    'GOMEMLIMIT=1536MiB' \
    'GOMODCACHE=/cachi2/output/deps/gomod/pkg/mod' \
    'GONOPROXY=' \
    'GONOSUMDB=' \
    'GOOS=linux' \
    'GOPATH=/tmp/gopath' \
    'GOPRIVATE=' \
    'GOPROXY=off' \
    'GOROOT=/usr/local/go' \
    'GOSUMDB=sum.golang.org' \
    'GOTOOLCHAIN=local' \
    'GOVCS=*:off' \
    'GOWORK=off' \
    'HOME=/tmp/home' \
    'LANG=C' \
    'LC_ALL=C' \
    'PATH=/usr/local/go/bin:/usr/bin:/bin' \
    'TMPDIR=/tmp' \
    'TZ=UTC' \
    /bin/sh -ec 'test "$(go env GOVERSION)" = go1.26.11 && go mod verify && go build -mod=readonly -trimpath -buildvcs=false -pgo=off -p=2 -o /service ./out'
FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build --chmod=0555 /service /service
USER 65532:65532
ENTRYPOINT ["/service"]
