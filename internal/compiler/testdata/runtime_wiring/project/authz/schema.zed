definition user {}

definition service_account {}

// Each worker has its own relation on the tenant, whose tuple provisioning writes (ST-SUP-RC35-OC13).
definition tenant {
	relation worker_sync_partner_orders: service_account
	relation worker_apply_note_replies: service_account
	// The relation of a worker that a release removed: the reconcile of the controller mode deletes its tuples, and a
	// later release drops it (ST-SUP-RC35-OC13).
	relation worker_retired_export: service_account
}

definition service {
	relation operator: user
	// The first administrators of a tenant, on its tenant-qualified service-level resource (ST-SUP-RC27-OC13).
	relation admin: user
	permission provision = operator
	permission retire = operator
}

definition order {
	relation owner: user
	relation viewer: user
	// The workers sync-partner-orders and apply-note-replies sync an order on which the check grants them.
	relation syncer: service_account
	// The runtime relates each new order to its tenant (ST-SUP-Q132), so each worker reaches the orders of a tenant
	// only by its own relation on that tenant, which provisioning writes (ST-SUP-RC35-OC13).
	relation tenant: tenant
	permission view = owner + viewer
	permission edit = owner
	permission sync = syncer
	permission tenant_sync = tenant->worker_sync_partner_orders
	permission tenant_apply = tenant->worker_apply_note_replies
}

definition note {
	relation order: order
	relation viewer: user
	permission view = viewer + order->view
}
