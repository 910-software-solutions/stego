// Revocation is the Authz-Revocation-Location of the last write of the CLI with this configuration, which each apply
// lookup sends in Authz-Revocation-After, and RevocationAt is when the CLI kept it (ST-SUP-RC04-OC37). A new login
// starts with none.
type configuration struct{URL string `json:"url"`;CAFile string `json:"ca_file"`;TokenFile string `json:"token_file"`;OAuth *oauthSession `json:"oauth,omitempty"`;Revocation string `json:"revocation,omitempty"`;RevocationAt time.Time `json:"revocation_at,omitzero"`}
// revocationLocation is the form of the Authz-Revocation-Location that the CLI keeps: the path of the revocation
// status route and the identity of a revocation, a UUID in its canonical form.
var revocationLocation=regexp.MustCompile(`^/authz/revocations/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
// revocationAge is the age after which a lookup no longer sends a kept revocation: by then its relationships are
// written, or they are stuck, and a wait would only slow each lookup (security review of PR #474, L2).
const revocationAge=10*time.Minute
// revocationNow gives the time of a kept revocation. Only the tests of this package change it.
var revocationNow=time.Now
// sameSource tells whether two configurations send requests to one service with one credential: the URL, the CA
// file, the token file, and the issuer, client, subject and login nonce of an OIDC session, which a refresh keeps. A
// revocation of a write is kept only in the configuration that sent the write, not in one of a later login (security
// review of PR #474, L1).
func sameSource(a,b configuration)bool{
 if a.URL!=b.URL||a.CAFile!=b.CAFile||a.TokenFile!=b.TokenFile||(a.OAuth==nil)!=(b.OAuth==nil){return false}
 return a.OAuth==nil||(a.OAuth.Issuer==b.OAuth.Issuer&&a.OAuth.ClientID==b.OAuth.ClientID&&a.OAuth.Subject==b.OAuth.Subject&&a.OAuth.Nonce==b.OAuth.Nonce)
}
// lookupRevocation is the revocation that the lookups of one apply wait for: the kept one, while it is younger than
// revocationAge, then that of each later write of the apply (ST-SUP-RC04-OC37). sent is the configuration of the
// requests of the apply.
type lookupRevocation struct{value string;app Application;sent configuration}
func newLookupRevocation(app Application,cfg configuration)*lookupRevocation{
 r:=&lookupRevocation{app:app,sent:cfg}
 if cfg.Revocation!=""&&revocationNow().Sub(cfg.RevocationAt)<revocationAge{r.value=cfg.Revocation}
 return r
}
// headers gives the headers of a lookup: with Authz-Revocation-After and Prefer: wait=10 when there is a
// revocation, so the list waits for it, within the 15 s of a request, before it reads.
func (r *lookupRevocation)headers(headers http.Header)http.Header{
 if r==nil||r.value==""{return headers}
 headers=headers.Clone();headers.Set("Authz-Revocation-After",r.value);headers.Set("Prefer","wait=10");return headers
}
// seen reads the Authz-Revocation of a lookup answer. A state that is not pending (complete, failed, parked, expired,
// or unknown for a revocation that is not the caller's own) ends the wait: the later lookups send no revocation, and
// the configuration no longer keeps it, so a stuck revocation does not slow each later lookup (security review of PR
// #474, L2).
func (r *lookupRevocation)seen(ctx context.Context,response client.Response){
 if r==nil||r.value==""{return}
 switch response.Header.Get("Authz-Revocation"){
 case "complete","failed","parked","expired","unknown":
 default:return
 }
 value:=r.value;r.value=""
 root,name,release,err:=configGuard(ctx,r.app,false);if err!=nil{return};defer release()
 cfg,err:=loadConfiguration(root,name);if err!=nil||cfg.Revocation!=value{return}
 cfg.Revocation,cfg.RevocationAt="",time.Time{}
 _ = saveConfiguration(root,name,cfg)
}
// keep takes the revocation of a successful write for the later lookups of the apply, and keeps it in the
// configuration.
func (r *lookupRevocation)keep(ctx context.Context,response client.Response){
 if value:=keepRevocation(ctx,r.app,r.sent,response);value!=""{r.value=value}
}
// keepRevocation keeps the Authz-Revocation-Location of a successful write in the configuration file, under its lock,
// with the time, and gives it; it gives "" for an answer with no such header or another form, and keeps nothing then.
// It keeps nothing when the configuration is no longer of the same source as sent, the configuration that sent the
// write, such as after a login to another service. A failure to keep it changes no outcome of the write: the CLI
// writes a warning (ST-SUP-RC04-OC37).
func keepRevocation(ctx context.Context,app Application,sent configuration,response client.Response)string{
 values:=response.Header.Values("Authz-Revocation-Location")
 if len(values)!=1||!revocationLocation.MatchString(values[0]){return ""}
 warn:=func(){_,_ = fmt.Fprintln(warnings,"warning: the CLI could not keep the revocation of the write in its configuration; a later apply can miss the resource of this write while its relationships are written")}
 root,name,release,err:=configGuard(ctx,app,false);if err!=nil{warn();return values[0]};defer release()
 cfg,err:=loadConfiguration(root,name);if err!=nil{warn();return values[0]}
 if !sameSource(cfg,sent){return values[0]}
 cfg.Revocation,cfg.RevocationAt=values[0],revocationNow().UTC()
 if saveConfiguration(root,name,cfg)!=nil{warn()}
 return values[0]
}
func configLocation(app Application)(string,error){
 if value:=os.Getenv(app.ConfigEnv);value!=""{return filepath.Abs(value)}
 base,err:=os.UserConfigDir();if err!=nil{return "",errors.New("cannot locate CLI configuration")}
 return filepath.Join(base,app.ConfigName,"config.json"),nil
}
func configRoot(app Application,create bool)(*os.Root,string,error){
 location,err:=configLocation(app);if err!=nil{return nil,"",err}
 parent:=filepath.Dir(location)
 if create{if err:=os.MkdirAll(parent,0700);err!=nil{return nil,"",errors.New("cannot create configuration directory")}}
 root,err:=os.OpenRoot(parent);if err!=nil{return nil,"",errors.New("cannot open configuration directory")}
 info,err:=root.Stat(".");if err!=nil||info.Mode().Perm()&0022!=0{root.Close();return nil,"",errors.New("configuration directory must not permit writes by other users")}
 return root,filepath.Base(location),nil
}
func login(ctx context.Context,app Application,args []string,output io.Writer)error{
 values,positions,err:=parse(args,false);if err!=nil||len(positions)!=0{return errArguments}
 for key:=range values{switch key{case "url","token-file","ca-file","issuer-url","issuer-ca-file","client-id","no-browser":default:return errArguments}}
 if values["url"]==""{return errors.New("login requires --url")}
 cfg:=configuration{URL:values["url"]}
 if values["ca-file"]!=""{cfg.CAFile,err=filepath.Abs(values["ca-file"]);if err!=nil{return errors.New("invalid CA file")}}
 transport,err:=client.New(client.Options{BaseURL:cfg.URL,CAFile:cfg.CAFile,Timeout:15*time.Second});if err!=nil{return err};transport.Close()
 root,name,release,err:=configGuard(ctx,app,true);if err!=nil{return err};defer release()
 if values["token-file"]!=""{
  for _,key:=range []string{"issuer-url","issuer-ca-file","client-id","no-browser"}{if _,present:=values[key];present{return errArguments}}
  cfg.TokenFile,err=filepath.Abs(values["token-file"]);if err!=nil{return errors.New("invalid token file")}
  if _,err:=readToken(cfg.TokenFile);err!=nil{return err}
 }else{
  if _,present:=values["token-file"];present{return errArguments}
  cfg.OAuth,err=oidcLogin(ctx,app,values,output);if err!=nil{return err}
 }
 if err:=saveConfiguration(root,name,cfg);err!=nil{return err}
 _,err=fmt.Fprintln(output,"Configuration saved.");return err
}
func saveConfiguration(root *os.Root,name string,cfg configuration)error{
 if info,err:=root.Lstat(name);err==nil{if !info.Mode().IsRegular()||info.Mode().Perm()&0077!=0{return errors.New("invalid existing configuration file")}}else if !os.IsNotExist(err){return errors.New("cannot inspect configuration file")}
 data,err:=json.Marshal(cfg);if err!=nil||len(data)>65536{return errors.New("configuration exceeds its limit")}
 // Open the directory through os.Root. A random, exclusive file and rename
 // prevent a partial configuration and do not follow an existing leaf link.
 temporary:=".stego-cli-"+rand.Text()
 file,err:=root.OpenFile(temporary,os.O_WRONLY|os.O_CREATE|os.O_EXCL,0600);if err!=nil{return errors.New("cannot create configuration file")}
 defer root.Remove(temporary)
 if _,err=file.Write(data);err==nil{err=file.Sync()};closeErr:=file.Close()
 if err!=nil||closeErr!=nil{return errors.New("cannot write configuration file")}
 if err:=root.Rename(temporary,name);err!=nil{return errors.New("cannot replace configuration file")}
 directory,err:=root.Open(".");if err!=nil{return errors.New("cannot sync configuration directory")};err=directory.Sync();directory.Close();if err!=nil{return errors.New("cannot sync configuration directory")}
 return nil
}
func load(app Application)(configuration,error){
 var cfg configuration
 root,name,err:=configRoot(app,false);if err!=nil{return cfg,err};defer root.Close()
 return loadConfiguration(root,name)
}
func loadConfiguration(root *os.Root,name string)(configuration,error){
 var cfg configuration
 file,err:=root.OpenFile(name,os.O_RDONLY|syscall.O_NONBLOCK|syscall.O_NOFOLLOW,0);if err!=nil{return cfg,errors.New("cannot read configuration file")};defer file.Close()
 data,err:=readRegular(file,65536,true);if err!=nil{return cfg,err}
 if _,err:=object(data);err!=nil{return cfg,err}
 decoder:=json.NewDecoder(bytes.NewReader(data));decoder.DisallowUnknownFields()
 if decoder.Decode(&cfg)!=nil||cfg.URL==""||(cfg.OAuth==nil&&!filepath.IsAbs(cfg.TokenFile))||(cfg.OAuth!=nil&&(cfg.TokenFile!=""||!validSession(cfg.OAuth)))||(cfg.CAFile!=""&&!filepath.IsAbs(cfg.CAFile))||(cfg.Revocation!=""&&(!revocationLocation.MatchString(cfg.Revocation)||cfg.RevocationAt.IsZero()))||(cfg.Revocation==""&&!cfg.RevocationAt.IsZero()){return configuration{},errors.New("invalid configuration file")}
 return cfg,nil
}
func logout(ctx context.Context,app Application)error{
 root,name,release,err:=configGuard(ctx,app,false);if err!=nil{return err};defer release()
 cfg,err:=loadConfiguration(root,name)
 if err!=nil{return err}
 var revokeErr error
 if cfg.OAuth!=nil{revokeErr=revokeSession(ctx,cfg.OAuth)}
 if err:=root.Remove(name);err!=nil&&!os.IsNotExist(err){return errors.New("cannot remove configuration")}
 directory,err:=root.Open(".");if err!=nil{return errors.New("cannot sync configuration directory")};defer directory.Close()
 if err:=directory.Sync();err!=nil{return errors.New("cannot sync configuration directory")}
 return revokeErr
}
// readToken reads the token file: a private file (ownedPrivate) of at most 16,384 bytes. O_NOFOLLOW refuses a leaf
// symbolic link, and readRegular a FIFO and a device.
func readToken(name string)(string,error){
 file,err:=os.OpenFile(name,os.O_RDONLY|syscall.O_NONBLOCK|syscall.O_NOFOLLOW,0);if err!=nil{return "",errors.New("cannot read token file")};defer file.Close()
 data,err:=readRegular(file,16384,true);if err!=nil{return "",errors.New("invalid token file: it must be a regular file that you own, with no group or other access")}
 token:=strings.TrimSpace(string(data));if token==""{return "",errors.New("empty token file")}
 for _,r:=range token{if !((r>='a'&&r<='z')||(r>='A'&&r<='Z')||(r>='0'&&r<='9')||strings.ContainsRune("-._~+/=",r)){return "",errors.New("invalid token file")}}
 return token,nil
}
// readBody reads a request body file and tells whether it is private
// (ownedPrivate).
func readBody(name string)([]byte,bool,error){
 // O_NOFOLLOW refuses a leaf symbolic link. readRegular refuses a FIFO and
 // a device.
 file,err:=os.OpenFile(name,os.O_RDONLY|syscall.O_NONBLOCK|syscall.O_NOFOLLOW,0);if err!=nil{return nil,false,errors.New("cannot read request body file")};defer file.Close()
 info,err:=file.Stat();if err!=nil{return nil,false,errors.New("invalid CLI input file")}
 data,err:=readRegular(file,65536,false);return data,ownedPrivate(info),err
}
// ownedPrivate tells whether a file is private: the effective user owns it, as ssh checks for its keys, and it permits
// no group or other access. Another user who owns the file could change it, or its mode, between two runs. The token
// file, the configuration file and a body file that holds a secret field must be private (security review of PR
// #462, L3).
func ownedPrivate(info os.FileInfo)bool{
 owner,ok:=info.Sys().(*syscall.Stat_t)
 return ok&&int64(owner.Uid)==int64(effectiveUser())&&info.Mode().Perm()&0077==0
}
// effectiveUser gives the effective user ID of the process. Only the tests of this package change it, to see a file
// of another user.
var effectiveUser=os.Geteuid
// readRegular reads a regular file of at most limit bytes from the open file, so the checks and the read are of one
// file. With private, it refuses a file that is not ownedPrivate.
func readRegular(file *os.File,limit int64,private bool)([]byte,error){
 info,err:=file.Stat();if err!=nil||!info.Mode().IsRegular()||info.Size()>limit||(private&&!ownedPrivate(info)){return nil,errors.New("invalid CLI input file")}
 data,err:=io.ReadAll(io.LimitReader(file,limit+1));if err!=nil||len(data)==0||int64(len(data))>limit{return nil,errors.New("invalid CLI input file")}
 return data,nil
}
