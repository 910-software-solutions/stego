// apiRoute is one declared API of the setting apis: its prefix and the bounded client of its one fixed origin, which
// STEGO_BROWSER_API_URLS gives at start and which never changes after (ST-SUP-RC02-OC58).
type apiRoute struct{name,prefix string;upstream *client.Client;permits,waits chan struct{};sessions *waitSessions}
// waitSessions counts the slots of the wait pool of one API that each session holds (MaxWaitsPerSession).
type waitSessions struct{mu sync.Mutex;held map[string]int}
// take takes a slot of the session id, and tells whether the session held fewer than MaxWaitsPerSession.
func(s *waitSessions)take(id string)bool{s.mu.Lock();defer s.mu.Unlock();if s.held[id]>=MaxWaitsPerSession{return false};s.held[id]++;return true}
// give gives back a slot of the session id.
func(s *waitSessions)give(id string){s.mu.Lock();defer s.mu.Unlock();if s.held[id]--;s.held[id]<=0{delete(s.held,id)}}
// poolAPIs gives the API of api_prefix and each declared API a pool of permits and a pool of waiting reads of its
// own, so that a slow API cannot take the capacity of another, with at least one of each for each API. The 1 to 16
// APIs (MaxAPIs) keep the permits at most client.MaxConcurrentRequests in total; a waiting read holds a permit too,
// and the permits of the backend bound every request together (ST-SUP-Q213).
func poolAPIs(main *apiRoute,apis []apiRoute){
 n:=1+len(apis);share:=max(1,client.MaxConcurrentRequests/n);waits:=max(1,MaxWaitingReads/n)
 main.permits,main.waits,main.sessions=make(chan struct{},share),make(chan struct{},waits),&waitSessions{held:map[string]int{}}
 for i:=range apis{apis[i].permits,apis[i].waits,apis[i].sessions=make(chan struct{},share),make(chan struct{},waits),&waitSessions{held:map[string]int{}}}
}
// declaredAPIs reads STEGO_BROWSER_API_URLS, a comma-separated list of name=origin, once at start. It refuses a
// name that the declaration does not give, a name given two times or not given, and an address that is not an
// HTTPS origin on a cookie host other than the console's and not the origin of the issuer, so that no bearer token
// goes to the identity provider. Each API gets a bounded client of its own.
func declaredAPIs(o options,origin *url.URL)([]apiRoute,error){
 issuer,err:=httpsURL(o.Issuer);if err!=nil{return nil,errors.New("browser issuer requires an HTTPS URL")}
 var declared configuration
 if json.Unmarshal([]byte(generatedConfiguration),&declared)!=nil{return nil,errors.New("invalid generated browser configuration")}
 if len(declared.APIs)==0{if o.Upstreams!=""{return nil,errors.New("STEGO_BROWSER_API_URLS is given, and the declaration has no apis")};return nil,nil}
 given:=map[string]string{}
 for _,item:=range strings.Split(o.Upstreams,","){
  name,address,ok:=strings.Cut(strings.TrimSpace(item),"=")
  if !ok||name==""{return nil,errors.New("STEGO_BROWSER_API_URLS requires a list of name=origin")}
  if _,again:=given[name];again{return nil,errors.New("STEGO_BROWSER_API_URLS gives the API "+name+" two times")}
  given[name]=address
 }
 var routes []apiRoute
 for _,api:=range declared.APIs{
  address,ok:=given[api.Name];if !ok{closeAPIs(routes);return nil,errors.New("STEGO_BROWSER_API_URLS gives no origin for the API "+api.Name)}
  delete(given,api.Name)
  target,err:=httpsURL(address);if err!=nil||target.Path!=""||target.RawQuery!=""||target.ForceQuery||cookieHost(target)==cookieHost(origin)||(cookieHost(target)==cookieHost(issuer)&&target.Port()==issuer.Port()){closeAPIs(routes);return nil,errors.New("browser API "+api.Name+" requires an HTTPS origin other than those of the console and the issuer")}
  c,err:=client.New(client.Options{BaseURL:address,CAFile:o.UpstreamCA});if err!=nil{closeAPIs(routes);return nil,err}
  routes=append(routes,apiRoute{name:api.Name,prefix:api.Prefix,upstream:c})
 }
 for name:=range given{closeAPIs(routes);return nil,errors.New("STEGO_BROWSER_API_URLS names the API "+name+", which the declaration does not give")}
 return routes,nil
}
func closeAPIs(routes []apiRoute){for _,r:=range routes{r.upstream.Close()}}
// apiPrefix gives the prefix and the client of the API whose prefix the path is under, at a whole segment: the
// declared prefixes do not overlap, so at most one matches. It gives no client for a path under no API prefix.
func(b *Backend)apiPrefix(p string)*apiRoute{
 if p==b.config.Prefix||strings.HasPrefix(p,b.config.Prefix+"/"){return &b.main}
 for i:=range b.apis{if p==b.apis[i].prefix||strings.HasPrefix(p,b.apis[i].prefix+"/"){return &b.apis[i]}}
 return nil
}
