// Field describes one public request property. Types are string, string-list,
// integer, and boolean. The CLI never accepts arbitrary headers or destinations.
// RelativeFlag accepts a positive duration and sends this string field as an
// absolute UTC RFC 3339 timestamp. It is exclusive with Flag and body files.
type Field struct {Flag,Key,Type,RelativeFlag string;Required,Nullable bool}
type PathParameter struct {Flag,Key string}
// IdempotentWrites states that the service keeps the Idempotency-Key of this POST or PATCH command: its OpenAPI
// operation carries the Idempotency-Key header parameter (the idempotency component). Then the CLI sends the write
// again one time, with the same key, after a transport failure, an expired request or a 5xx answer that carries
// Idempotency-Kept: 1. The CLI sends a new key with each POST and PATCH in either case. IdempotentWritesFrom sets it from the OpenAPI document.
type Command struct {Name []string;Method,Path string;ID,Query,Confirm,Sensitive,IdempotentWrites bool;PathParameters []PathParameter;Fields []Field;BodyFields []Field;Success,EmptyResponses []int}
type Application struct {VersionCommand bool;ConfigEnv,ConfigName,OIDCClientID,IdentityPath string;Commands []Command;Resources []ApplyResource}
var word=regexp.MustCompile(`^[a-z][a-zA-Z0-9-]{0,63}$`)
var pathPart=regexp.MustCompile(`^[a-zA-Z0-9._~!$&'()*+,;=:@-]+$`)
var property=regexp.MustCompile(`^[a-zA-Z][a-zA-Z0-9_]{0,63}$`)
var envName=regexp.MustCompile(`^[A-Z][A-Z0-9_]{0,63}$`)
var identifier=regexp.MustCompile(`^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,255}$`)
var errArguments=errors.New("invalid command arguments; use --help")

func validate(app Application)error{
 if app.IdentityPath!="" {
  probe:=Application{ConfigEnv:app.ConfigEnv,ConfigName:app.ConfigName,Commands:[]Command{ {Name:[]string{"identity-check"},Method:"GET",Path:app.IdentityPath,Success:[]int{200}}}}
  if err:=validate(probe);err!=nil{return errors.New("invalid CLI identity route")}
 }
 if app.OIDCClientID!=""&&!safeClientID(app.OIDCClientID){return errors.New("invalid OIDC client ID")}
 if !envName.MatchString(app.ConfigEnv)||!word.MatchString(app.ConfigName)||(len(app.Commands)==0&&len(app.Resources)==0&&app.IdentityPath==""&&!app.VersionCommand)||len(app.Commands)>128{return errors.New("invalid CLI definition")}
 seen:=map[string]bool{}
 for _,c:=range app.Commands{
  if len(c.Name)<1||len(c.Name)>4 {return errors.New("invalid CLI command name")}
  for _,name:=range c.Name{if !word.MatchString(name){return errors.New("invalid CLI command name")}}
  if app.VersionCommand&&c.Name[0]=="version"{return errors.New("reserved CLI version command")};if app.IdentityPath!=""&&c.Name[0]=="whoami"{return errors.New("reserved CLI identity command")};if c.Name[0]=="apply"||c.Name[0]=="login"||c.Name[0]=="logout"||c.Name[0]=="help"{return errors.New("reserved CLI command name")}
  name:=strings.Join(c.Name," ");for other:=range seen{if name==other||strings.HasPrefix(name,other+" ")||strings.HasPrefix(other,name+" "){return errors.New("ambiguous CLI command")}};seen[name]=true
  u,err:=url.Parse(c.Path)
  if err!=nil||u.IsAbs()||u.Host!=""||!strings.HasPrefix(c.Path,"/")||strings.HasPrefix(c.Path,"//")||u.RawQuery!=""||u.Fragment!=""||strings.ContainsAny(c.Path,"%\\\x00\r\n")||len(c.Path)>1024{return errors.New("invalid CLI route")}
  parameters:=map[string]bool{}
  pathFlags:=map[string]bool{}
  if len(c.PathParameters)>8{return errors.New("too many CLI path parameters")}
  for _,p:=range c.PathParameters{
   if !word.MatchString(p.Flag)||!property.MatchString(p.Key)||p.Key=="id"||reservedFlag(p.Flag)||parameters[p.Key]||pathFlags[p.Flag]||strings.Count(c.Path,"{"+p.Key+"}")!=1{return errors.New("invalid CLI path parameter")}
   parameters[p.Key],pathFlags[p.Flag]=true,true
  }
  for _,part:=range strings.Split(strings.TrimPrefix(c.Path,"/"),"/"){if part=="{id}"&&c.ID {continue};if strings.HasPrefix(part,"{")&&strings.HasSuffix(part,"}")&&parameters[part[1:len(part)-1]]{continue};if part=="."||part==".."||!pathPart.MatchString(part){return errors.New("invalid CLI route segment")}}
  if c.ID!=(strings.Count(c.Path,"{id}")==1){return errors.New("invalid CLI route parameter")}
  switch c.Method{case "GET","POST","PATCH","PUT","DELETE":default:return errors.New("invalid CLI method")}
  if c.IdempotentWrites&&c.Method!="POST"&&c.Method!="PATCH"{return errors.New("invalid CLI idempotent write")}
  if len(c.Success)==0||len(c.Success)>4||len(c.Fields)>64{return errors.New("invalid CLI command limits")}
  for _,code:=range c.Success{if code<200||code>299{return errors.New("invalid CLI success code")}}
  if len(c.EmptyResponses)>len(c.Success){return errors.New("invalid empty response codes")}
  emptyCodes:=map[int]bool{}
  for _,code:=range c.EmptyResponses{
   found:=false;for _,success:=range c.Success{if code==success{found=true}}
   if !found||emptyCodes[code]{return errors.New("invalid empty response code")};emptyCodes[code]=true
  }
  flags,keys:=map[string]bool{},map[string]bool{}
  for _,f:=range c.Fields{
   if !word.MatchString(f.Flag)||!property.MatchString(f.Key)||flags[f.Flag]||keys[f.Key]||reservedFlag(f.Flag)||pathFlags[f.Flag]{return errors.New("invalid CLI field")}
   flags[f.Flag],keys[f.Key]=true,true
   if f.RelativeFlag!="" {
    if f.Type!="string"||c.Query||(c.Method!="POST"&&c.Method!="PUT"&&c.Method!="PATCH")||!word.MatchString(f.RelativeFlag)||reservedFlag(f.RelativeFlag)||flags[f.RelativeFlag]||pathFlags[f.RelativeFlag]{return errors.New("invalid relative timestamp flag")}
    flags[f.RelativeFlag]=true
   }
   switch f.Type{case "string","string-list","integer","boolean":default:return errors.New("invalid CLI field type")}
  }
  // A body field, a secret, has no flag: only --body FILE gives it (ST-SUP-RC04-OC32).
  for _,f:=range c.BodyFields{
   if f.Flag!=""||f.RelativeFlag!=""||!property.MatchString(f.Key)||keys[f.Key]||c.Query||(c.Method!="POST"&&c.Method!="PUT"&&c.Method!="PATCH"){return errors.New("invalid CLI body field")}
   keys[f.Key]=true
   switch f.Type{case "string","string-list","integer","boolean":default:return errors.New("invalid CLI field type")}
  }
  if !c.Query&&len(c.Fields)>0&&(c.Method=="GET"||c.Method=="DELETE"){return errors.New("CLI read and delete fields require query mode")}
 }
 return validateApply(app.Resources)
}

func reservedFlag(flag string)bool{return flag=="body"||flag=="yes"||flag=="help"||flag=="output-file"||flag=="no-browser"}

// Run performs one command. Cancellation bounds network work. Configuration
// stores a token-file reference or a private OIDC session.
func Run(ctx context.Context,app Application,args []string,output io.Writer)error{
 if ctx==nil||output==nil{return errors.New("CLI context and output are required")}
 if err:=ctx.Err();err!=nil{return err}
 if err:=validate(app);err!=nil{return err}
 if len(args)>256{return errArguments};size:=0
 for _,arg:=range args{size+=len(arg);if len(arg)>4096||size>65536||!utf8.ValidString(arg)||strings.ContainsRune(arg,0){return errArguments}}
 if len(args)==0||(len(args)==1&&(args[0]=="--help"||args[0]=="help")){
  names:=[]string{"login --url URL --token-file FILE [--ca-file FILE]","login --url URL --issuer-url URL [--client-id ID] [--no-browser] [--ca-file FILE] [--issuer-ca-file FILE]","logout"}
  if app.VersionCommand{names=append(names,"version")};if app.IdentityPath!=""{names=append(names,"whoami [--show-token | --show-token-decoded] [--output-file FILE]")};if len(app.Resources)>0{names=append(names,"apply -f FILE [--dry-run] [-o json]")};for _,c:=range app.Commands{names=append(names,strings.Join(c.Name," "))};sort.Strings(names)
  _,err:=fmt.Fprintln(output,strings.Join(names,"\n"));return err
 }
 if args[0]=="version"&&app.VersionCommand{return versionReport(args[1:],output)}
 if args[0]=="whoami"&&app.IdentityPath!=""{return whoami(ctx,app,args[1:],output)}
 if args[0]=="apply"{return runApply(ctx,app,args[1:],output)}
 if args[0]=="login"{return login(ctx,app,args[1:],output)}
 if args[0]=="logout"{if len(args)!=1{return errArguments};return logout(ctx,app)}
 var selected *Command
 for i:=range app.Commands{c:=&app.Commands[i];if len(args)<len(c.Name){continue};match:=true;for j,name:=range c.Name{if args[j]!=name{match=false;break}};if match{selected=c;break}}
 if selected==nil{return errArguments};c:=*selected;arguments:=args[len(c.Name):]
 fields:=map[string]Field{}
 for _,f:=range c.Fields{fields[f.Flag]=f;if f.RelativeFlag!=""{fields[f.RelativeFlag]=f}}
 if len(arguments)==1&&arguments[0]=="--help"{
  var names []string;for _,f:=range c.Fields{names=append(names,"--"+f.Flag+" ("+f.Type+")");if f.RelativeFlag!=""{names=append(names,"--"+f.RelativeFlag+" DURATION (exclusive with --"+f.Flag+")")}}
  for _,p:=range c.PathParameters{names=append(names,"--"+p.Flag+" ID (required)")};if c.Sensitive{names=append(names,"--output-file FILE (required)")}else{names=append(names,"--output-file FILE (- selects stdout)")}
  if c.Method=="POST"||c.Method=="PUT"||c.Method=="PATCH"{names=append(names,"--body FILE")};if c.Confirm{names=append(names,"--yes")};sort.Strings(names)
  _,err:=fmt.Fprintln(output,strings.Join(names,"\n"));return err
 }
 values,positions,err:=parse(arguments,c.Confirm);if err!=nil{return err}
 if (c.ID&&len(positions)!=1)||(!c.ID&&len(positions)!=0){return errArguments}
 route:=c.Path
 if c.ID{if !identifier.MatchString(positions[0]){return errArguments};route=strings.Replace(route,"{id}",url.PathEscape(positions[0]),1)}
 for _,p:=range c.PathParameters{value,ok:=values[p.Flag];if !ok||!identifier.MatchString(value){return errArguments};route=strings.Replace(route,"{"+p.Key+"}",url.PathEscape(value),1);delete(values,p.Flag)}
 outputFile,outputSet:=values["output-file"];delete(values,"output-file")
 if outputSet&&outputFile==""{return errors.New("this command requires --output-file FILE; use - only for explicit stdout output")}
 // The answer of a Sensitive command holds a secret: it goes only to a private file, never to stdout (security review of PR #460, I1).
 if c.Sensitive&&(!outputSet||outputFile=="-"){return errors.New("this command answer holds a secret and requires --output-file FILE; stdout is not permitted")}
 if c.Confirm{if values["yes"]!="true"{return errors.New("confirmation required: pass --yes")};delete(values,"yes")}
 body:=map[string]json.RawMessage{}
 if name,ok:=values["body"];ok{
  if c.Query||(c.Method!="POST"&&c.Method!="PATCH"&&c.Method!="PUT")||len(values)!=1{return errArguments}
  data,private,err:=readBody(name);if err!=nil{return err}
  if body,err=object(data);err!=nil{return err};delete(values,"body")
  // A file that holds a secret body field is private, as the token file is (security review of PR #460, L3, and of PR
  // #462, L3).
  for _,f:=range c.BodyFields{if _,ok:=body[f.Key];ok&&!private{return errors.New("a request body file that holds a secret field must be your own file and must not permit access by other users")}}
 }
 now:=time.Now()
 for flag,value:=range values{
  field,ok:=fields[flag];if !ok{return errArguments}
  if field.RelativeFlag!=""&&flag==field.RelativeFlag{
   if _,present:=values[field.Flag];present{return errArguments}
   value,err=relativeTimestamp(value,now);if err!=nil{return err}
  }
  raw:=[]byte(value);if field.Type=="string"{raw,_=json.Marshal(value)}
  body[field.Key]=raw
 }
 allowed:=map[string]Field{};for _,f:=range append(append([]Field(nil),c.Fields...),c.BodyFields...){allowed[f.Key]=f;if f.Required{if _,ok:=body[f.Key];!ok{return errors.New("required request field is missing")}}}
 for key,raw:=range body{field,ok:=allowed[key];if !ok||!fieldValue(field,raw){return errors.New("invalid request field")}}
 var payload []byte
 if c.Query{
  query:=url.Values{}
  for key,raw:=range body{field:=allowed[key];if field.Type=="string"{var value string;_ = json.Unmarshal(raw,&value);query.Set(key,value)}else{query.Set(key,string(raw))}}
  if len(query)>0{route+="?"+query.Encode()}
 }else if len(body)>0||c.Method=="POST"||c.Method=="PUT"||c.Method=="PATCH"{payload,err=json.Marshal(body);if err!=nil{return errors.New("cannot encode request")}}
 if len(payload)>65536{return errors.New("request body exceeds CLI limit")}
 destination,err:=reserveOutput(outputFile,output);if err!=nil{return err};defer destination.close()
 cfg,token,err:=requestCredentials(ctx,app);if err!=nil{return err}
 transport,err:=client.New(client.Options{BaseURL:cfg.URL,CAFile:cfg.CAFile,Timeout:15*time.Second});if err!=nil{return err};defer transport.Close()
 headers:=http.Header{"Authorization":{"Bearer "+token},"Accept":{"application/json"}}
 if payload!=nil{headers.Set("Content-Type","application/json")}
 response,retried,err:=send(ctx,c.IdempotentWrites,transport,c.Method,route,headers,payload);if err!=nil{return err}
 success:=false;for _,code:=range c.Success{if response.StatusCode==code{success=true}}
 if !success&&retried{return fmt.Errorf("API request outcome is unknown after a second request with the same key (HTTP %d); retrieve the resource before a retry",response.StatusCode)}
 // A 5xx answer to a write that was not sent again, such as one with no Idempotency-Kept header, can follow a write
 // that the service did (ST-SUP-RC04-OC34).
 if !success&&response.StatusCode>=500&&(c.Method=="POST"||c.Method=="PATCH"){return fmt.Errorf("API request failed (HTTP %d); the write was not sent again and can have been done; retrieve the resource before a new write",response.StatusCode)}
 if !success{return fmt.Errorf("API request failed (HTTP %d)",response.StatusCode)}
 emptyResponse:=response.StatusCode==204||response.StatusCode==205
 for _,code:=range c.EmptyResponses{if code==response.StatusCode{emptyResponse=true}}
 if emptyResponse{if len(response.Body)!=0{return errors.New("unexpected response body")};return destination.write(nil)}
 if !validJSON(response.Body){return errors.New("invalid API JSON response")}
 var formatted bytes.Buffer
 if err:=json.Indent(&formatted,response.Body,"","  ");err!=nil{return errors.New("invalid API JSON response")};formatted.WriteByte('\n')
 return destination.write(formatted.Bytes())
}

// idempotencyKey gives a new Idempotency-Key: a structured string that holds a random UUID (ST-SUP-RC04-OC31). It
// fails rather than give a key that is not random.
func idempotencyKey()(string,error){
 var b [16]byte;if _,err:=rand.Read(b[:]);err!=nil{return "",errors.New("cannot make an idempotency key")}
 b[6]=b[6]&0x0f|0x40;b[8]=b[8]&0x3f|0x80
 return fmt.Sprintf("\"%x-%x-%x-%x-%x\"",b[0:4],b[4:6],b[6:8],b[8:10],b[10:]),nil
}
// writeRetryWait is the wait before the second request of a write when the answer gives no Retry-After; a Retry-After
// of 1 to 5 seconds is followed. Only the tests of this package change it.
var writeRetryWait=time.Second
// warnings is where the CLI writes a warning that changes no answer and no exit code. Only the tests of this package
// change it.
var warnings io.Writer=os.Stderr
// keptHeader is the answer header with which the service tells that it keeps the Idempotency-Key of the request
// (ST-SUP-RC04-OC34).
const keptHeader="Idempotency-Kept"
// send sends one request. A POST or a PATCH gets a new Idempotency-Key. When keeps states that the service keeps the
// key of this write, a write that fails in transport or expires, or whose 5xx answer carries Idempotency-Kept: 1, is
// sent again one time, after a short wait, with the same key and body, so the service gives the stored answer of a
// write that it did (ST-SUP-RC04-OC31, ST-SUP-RC04-OC34). retried tells that the second request was sent: its answer,
// when it is not a success, leaves the outcome of the write unknown, as the first request can still be in its
// transaction. No other request is sent again (ST-SUP-RC04-OC05).
func send(ctx context.Context,keeps bool,transport *client.Client,method,route string,headers http.Header,payload []byte)(response client.Response,retried bool,err error){
 if method!="POST"&&method!="PATCH"{response,err=transport.Do(ctx,method,route,headers,payload);return}
 key,err:=idempotencyKey();if err!=nil{return}
 headers=headers.Clone();headers.Set("Idempotency-Key",key)
 response,err=transport.Do(ctx,method,route,headers,payload)
 if !keeps||!uncertain(response,err)||ctx.Err()!=nil{warnRelease(keeps,response,err);return}
 wait:=writeRetryWait
 if err==nil{if seconds,parseErr:=strconv.Atoi(response.Header.Get("Retry-After"));parseErr==nil&&seconds>=1&&seconds<=5{wait=time.Duration(seconds)*time.Second}}
 timer:=time.NewTimer(wait);defer timer.Stop()
 select{case <-ctx.Done():return response,false,err;case <-timer.C:}
 response,err=transport.Do(ctx,method,route,headers,payload)
 warnRelease(keeps,response,err)
 return response,true,err
}

// uncertain tells whether a write can have occurred with its answer lost and a second request with the same key is
// safe: a transport failure or a request that expired, which give no answer, or a 5xx answer that carries
// Idempotency-Kept: 1, the word of the service that it keeps the key. A 5xx answer with no such header, such as of a
// proxy or of a service of another release, is not sent again (ST-SUP-RC04-OC34). A local refusal of the client (such
// as a header or a body over its limit), a redirect and an answer body over the limit are not sent again (security
// review of PR 447, I-2).
func uncertain(response client.Response,err error)bool{
 if err!=nil{return errors.Is(err,client.ErrTransport)||errors.Is(err,client.ErrDeadline)}
 return response.StatusCode>=500&&kept(response)
}

// kept tells whether an answer carries Idempotency-Kept: 1, one time.
func kept(response client.Response)bool{
 values:=response.Header.Values(keptHeader);return len(values)==1&&values[0]=="1"
}

// warnRelease writes a warning when the application states that the service keeps the key of a write and a 2xx
// answer has no Idempotency-Kept header: the CLI and the service can then be of different releases. It changes no
// answer (ST-SUP-RC04-OC34).
func warnRelease(keeps bool,response client.Response,err error){
 if !keeps||err!=nil||response.StatusCode<200||response.StatusCode>299||kept(response){return}
 _,_ = fmt.Fprintln(warnings,"warning: the CLI states that the service keeps the Idempotency-Key of this write, but the answer has no Idempotency-Kept header; the CLI and the service can be of different releases, so build the CLI from the release of the service")
}

// IdempotentWritesFrom gives the application with IdempotentWrites set from the OpenAPI document of its service: true
// on each command whose operation, the method on the path, carries the Idempotency-Key header parameter, and on each
// apply resource whose create (POST on its path) carries it and, when the resource has patch fields, whose patch
// (PATCH on its path and /{id}) carries it too; false on each other command and resource. Paths match with any name in
// each {} segment. The rest-api component states the parameter on each create and patch when the service has the
// idempotency component (ST-SUP-RC30-OC01). A parameter given by $ref is not followed, so its write is not sent again.
func IdempotentWritesFrom(app Application,document []byte)(Application,error){
 invalid:=errors.New("invalid OpenAPI document")
 if len(document)>client.MaxResponseBytes{return app,invalid}
 var spec struct{Paths map[string]map[string]json.RawMessage `json:"paths"`}
 if json.Unmarshal(document,&spec)!=nil||spec.Paths==nil{return app,invalid}
 type parameter struct{Name string `json:"name"`;In string `json:"in"`}
 keyed:=map[string]bool{}
 for route,item:=range spec.Paths{
  var shared []parameter
  if raw,ok:=item["parameters"];ok&&json.Unmarshal(raw,&shared)!=nil{return app,invalid}
  for method,raw:=range item{
   if method!="post"&&method!="patch"{continue}
   var operation struct{Parameters []parameter `json:"parameters"`}
   if json.Unmarshal(raw,&operation)!=nil{return app,invalid}
   for _,p:=range append(append([]parameter(nil),shared...),operation.Parameters...){if p.In=="header"&&strings.EqualFold(p.Name,"Idempotency-Key"){keyed[strings.ToUpper(method)+" "+routeShape(route)]=true}}
  }
 }
 result:=app
 result.Commands=append([]Command(nil),app.Commands...)
 for i:=range result.Commands{c:=&result.Commands[i];c.IdempotentWrites=keyed[c.Method+" "+routeShape(c.Path)]}
 result.Resources=append([]ApplyResource(nil),app.Resources...)
 for i:=range result.Resources{r:=&result.Resources[i];r.IdempotentWrites=keyed["POST "+routeShape(r.Path)]&&(len(r.PatchFields)==0||keyed["PATCH "+routeShape(r.Path+"/{id}")])}
 return result,nil
}
// routeShape gives a path with each {} segment as {}, so that two names of one parameter match.
func routeShape(route string)string{
 parts:=strings.Split(route,"/");for i,part:=range parts{if strings.HasPrefix(part,"{")&&strings.HasSuffix(part,"}"){parts[i]="{}"}}
 return strings.Join(parts,"/")
}

func parse(args []string,confirm bool)(map[string]string,[]string,error){
 values:=map[string]string{};var positions []string
 for i:=0;i<len(args);i++{
  arg:=args[i]
  if !strings.HasPrefix(arg,"--"){positions=append(positions,arg);continue}
  key,value,has:=strings.Cut(strings.TrimPrefix(arg,"--"),"=")
  if key==""{return nil,nil,errArguments};if _,ok:=values[key];ok{return nil,nil,errArguments}
  if key=="no-browser"||(key=="yes"&&confirm){if !has{value="true"};if value!="true"&&value!="false"{return nil,nil,errArguments}}else if !has{if i+1==len(args){return nil,nil,errArguments};i++;value=args[i]}
  values[key]=value
 }
 return values,positions,nil
}
func fieldValue(field Field,raw []byte)bool{
 if !validJSON(raw){return false};if bytes.Equal(bytes.TrimSpace(raw),[]byte("null")){return field.Nullable&&!field.Required}
 valid:=func(value string)bool{return len(value)<=4096&&!strings.ContainsRune(value,0)}
 switch field.Type{
 case "string":var value string;return json.Unmarshal(raw,&value)==nil&&valid(value)
 case "integer":var value int64;return json.Unmarshal(raw,&value)==nil
 case "boolean":var value bool;return json.Unmarshal(raw,&value)==nil
 case "string-list":var value []string;if json.Unmarshal(raw,&value)!=nil||len(value)>100{return false};for _,s:=range value{if !valid(s){return false}};return true
 }
 return false
}
func object(data []byte)(map[string]json.RawMessage,error){
 if !validJSON(data){return nil,errors.New("invalid JSON object")}
 var result map[string]json.RawMessage
 if json.Unmarshal(data,&result)!=nil||result==nil{return nil,errors.New("invalid JSON object")}
 return result,nil
}
func validJSON(data []byte)bool{
 if len(data)>client.MaxResponseBytes||!utf8.Valid(data)||!validUnicodeEscapes(data){return false}
 decoder:=json.NewDecoder(bytes.NewReader(data));decoder.UseNumber();nodes:=0
 var visit func(int)bool
 visit=func(depth int)bool{
  nodes++;if depth>32||nodes>65536{return false}
  token,err:=decoder.Token();if err!=nil{return false}
  delim,ok:=token.(json.Delim);if !ok{return true}
  switch delim{
  case '{':seen:=map[string]bool{};for decoder.More(){key,err:=decoder.Token();if err!=nil{return false};name,ok:=key.(string);if !ok||seen[name]||len(seen)>=4096{return false};seen[name]=true;if !visit(depth+1){return false}};end,err:=decoder.Token();return err==nil&&end==json.Delim('}')
  case '[':for decoder.More(){if !visit(depth+1){return false}};end,err:=decoder.Token();return err==nil&&end==json.Delim(']')
  default:return false
  }
 }
 if !visit(1){return false};_,err:=decoder.Token();return err==io.EOF
}

// relativeTimestamp bounds parsing and prevents duration and calendar overflow.
// A day is exactly 24 hours. The API retains its domain lifetime policy.
func relativeTimestamp(value string,now time.Time)(string,error){
 if len(value)<1||len(value)>64{return "",errArguments}
 var duration time.Duration
 var err error
 if strings.HasSuffix(value,"d"){
  digits:=strings.TrimSuffix(value,"d")
  if digits==""{return "",errArguments}
  for _,c:=range digits{if c<'0'||c>'9'{return "",errArguments}}
  days,problem:=strconv.ParseUint(digits,10,64)
  if problem!=nil||days==0||days>uint64((1<<63-1)/(24*time.Hour)){return "",errArguments}
  duration=time.Duration(days)*24*time.Hour
 }else{duration,err=time.ParseDuration(value)}
 if err!=nil||duration<=0{return "",errArguments}
 result:=now.UTC().Add(duration)
 if result.Year()<1||result.Year()>9999||!result.After(now){return "",errArguments}
 return result.Format(time.RFC3339Nano),nil
}
