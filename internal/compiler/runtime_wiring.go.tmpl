// Package stegoruntime gives the service runtime of the runtime library (ST-SUP-RP14) what varies with the declaration
// of the service on the runtime data path (ST-SUP-RC01-OC41, ST-SUP-RC20-OC37): the names, the grants and the
// constructors of the component packages; service.New wires the runtimes and service.Migrate runs the migration job
// (ST-STD-RUNTIME-R05). It registers the routes of the declared commands and queries. The compiler writes this
// package for each service.
package stegoruntime

import (
	"context"
	"database/sql"
	"errors"
	"fmt"
	"log/slog"
	"net/http"
	"os"
	"slices"
	"strings"
	"sync"
	"time"

	"google.golang.org/grpc"

	"github.com/jsell-rh/stego/registry/runtime/audit"
	stegoauthz "github.com/jsell-rh/stego/registry/runtime/authz"
{{- if or .API .Commands}}
	"github.com/jsell-rh/stego/registry/runtime/command"
{{- end}}
	"github.com/jsell-rh/stego/registry/runtime/modes"
	"github.com/jsell-rh/stego/registry/runtime/outbox"
{{- if .Ring}}
	"github.com/jsell-rh/stego/registry/runtime/sealed"
{{- end}}
	"github.com/jsell-rh/stego/registry/runtime/service"

	svcaudit {{printf "%q" .Audit}}
	svcauthz {{printf "%q" .Authz}}
	svcoutbox {{printf "%q" .Outbox}}
	svcstorage {{printf "%q" .Storage}}
	svctenancy {{printf "%q" .Tenancy}}
{{- if .Idempotency}}
	svcidempotency {{printf "%q" .Idempotency}}
{{- end}}
{{- if .API}}
	api {{printf "%q" .API}}
{{- end}}
{{- if .Commands}}
	commandhandlers {{printf "%q" .Commands}}
{{- end}}
{{- if .Queries}}
	queryserve {{printf "%q" .Queries}}
{{- end}}
{{- if .Workers}}
	workerrunners {{printf "%q" .Workers}}
{{- end}}
{{- if .Inbox}}
	subscriptions {{printf "%q" .Inbox}}
{{- end}}
)

// The declaration of the service.
const (
	// Service is the name of the service, which its audit rows and its telemetry carry.
	Service = {{printf "%q" .Service}}
	// DeclarationVersion is the SHA-256 of the declaration, which each audit row carries.
	DeclarationVersion = {{printf "%q" .DeclarationVersion}}
	// subjectType is the subject type of the schema that a verified identity maps to.
	subjectType = {{printf "%q" .SubjectType}}
	// tenantClaim is the dotted path of the claim that names the caller's tenant.
	tenantClaim = {{printf "%q" .TenantClaim}}
	// problemType and problemCode are the problem base and the problem code prefix of a refused credential.
	problemType = {{printf "%q" .ProblemType}}
	problemCode = {{printf "%q" .ProblemCode}}
)

// The settings of the verifier that the declaration states, through the settings of its auth provider; an empty one
// is not stated. A stated setting wins: the environment may only match it.
const (
	declaredIssuer    = {{printf "%q" .Issuer}}
	declaredAudience  = {{printf "%q" .Audience}}
	declaredHeader    = {{printf "%q" .Header}}
	declaredKeyFile   = {{printf "%q" .KeyFile}}
	declaredRoleClaim = {{printf "%q" .RoleClaim}}
{{- if .Discovery}}
	// The auth provider finds the key set through the discovery document of the issuer (ST-SUP-RC37).
	declaredCAFile       = {{printf "%q" .CAFile}}
	declaredSubjectClaim = {{printf "%q" .SubjectClaim}}
{{- end}}
)

// declaredAuthComponent is the auth provider of the declaration, which the start stage of a refused verifier setting
// names (ST-SUP-RP14-LC05).
const declaredAuthComponent = {{printf "%q" .AuthComponent}}

// The roles of the database, which the role migration of the tenancy component makes (ST-SUP-RC27-OC04). WorkerRole
// is the role that the outbox worker connects as, RelayRole the role of the authorization relay, PurgeRole the
// role of this service that owns the purge function of the idempotency key table (ST-SUP-RP07-LC11) and
// OutboxRelayRole the role of this service that owns the outbox relay functions (ST-SUP-RP01-LC19).
const (
	RuntimeRole     = svctenancy.RuntimeRole
	OwnerRole       = svctenancy.OwnerRole
	WorkerRole      = svctenancy.WorkerRole
	RelayRole       = svctenancy.RelayRole
	PurgeRole       = svctenancy.PurgeRole
	OutboxRelayRole = svctenancy.OutboxRelayRole
)

// The settings of the deployment, which the process environment gives by the fixed names of the service runtime
// (ST-SUP-RP14-LC01).
const (
	DatabaseURLSetting              = service.DatabaseURLSetting
	DatabaseURLFileSetting          = service.DatabaseURLFileSetting
	MigrationDatabaseURLSetting     = service.MigrationDatabaseURLSetting
	MigrationDatabaseURLFileSetting = service.MigrationDatabaseURLFileSetting
	IssuerSetting                   = service.IssuerSetting
	AudienceSetting                 = service.AudienceSetting
	KeysURLSetting                  = service.KeysURLSetting
	KeysFileSetting                 = service.KeysFileSetting
	CAFileSetting                   = service.CAFileSetting
	SpiceDBEndpointSetting          = service.SpiceDBEndpointSetting
	SpiceDBKeyFileSetting           = service.SpiceDBKeyFileSetting
	SpiceDBInsecureLoopbackSetting  = service.SpiceDBInsecureLoopbackSetting
	CursorKeyFileSetting            = service.CursorKeyFileSetting
	VersionSetting                  = service.VersionSetting
	WorkerDatabaseURLSetting        = service.WorkerDatabaseURLSetting
	WorkerDatabaseURLFileSetting    = service.WorkerDatabaseURLFileSetting
	RelayDatabaseURLSetting         = service.RelayDatabaseURLSetting
	RelayDatabaseURLFileSetting     = service.RelayDatabaseURLFileSetting
)

// grants are the privileges of the runtime role on the objects of the database access contract and on the
// idempotency keys, each without its grantee, which the migration job grants after it made the objects.
var grants = []string{
{{- range .Grants}}
	{{printf "%q" .}},
{{- end}}
}

// Runtime holds the runtime of the running service, which the service runtime wires (ST-SUP-RP14-LC02), and the
// routes of its declared commands and queries.
type Runtime struct {
	svc       *service.Service
{{- if .API}}
	afterSlots *api.AfterSlots
{{- end}}
	routes    *http.ServeMux
	selection modes.Selection
	// workerSettings are the connection settings of the worker mode, which NewService reads at the start.
	workerSettings service.WorkerSettings

	mu      sync.Mutex
	workers *service.Workers
}

// declared are the settings of the verifier that the declaration states.
var declared = service.Auth{Issuer: declaredIssuer, Audience: declaredAudience, Header: declaredHeader, KeyFile: declaredKeyFile,
	RoleClaim: declaredRoleClaim, Component: declaredAuthComponent{{if .Discovery}}, Discovery: true, CAFile: declaredCAFile, SubjectClaim: declaredSubjectClaim,
	Algorithms: []string{ {{- range $i, $a := .Algorithms}}{{if $i}}, {{end}}{{printf "%q" $a}}{{end -}} }{{end}}}

// StartStage names the stage of a start that a setting, the database pool, the key source or the schema manifest
// refused, for the failure record of the process, which holds no error text and no value (ST-SUP-RP14-LC05).
func StartStage(err error) string {
{{- if or .KafkaTopic .Inbox}}
	var setting *startSetting
	if errors.As(err, &setting) {
		return "service.start.setting." + setting.component + "." + setting.variable
	}
{{- end}}
	return service.StartStage(err)
}
{{- if or .KafkaTopic .Inbox}}

// startSetting is a setting that the start of the service refused before the runtime read it: the variable at fault
// and the registry component that reads it. It holds no value.
type startSetting struct{ component, variable, problem string }

func (e *startSetting) Error() string { return "the setting " + e.variable + " " + e.problem }
{{- end}}
{{- if .KafkaTopic}}

// checkKafkaTopic refuses a worker mode that has no Kafka topic. With none, the destination sends each message to
// the topic of its event type, which the topic need does not state, so every delivery is refused for ever
// (walkthrough 7, B7).
func checkKafkaTopic() error {
	if os.Getenv("STEGO_KAFKA_TOPIC") == "" && os.Getenv("STEGO_KAFKA_TOPIC_FILE") == "" {
		return &startSetting{component: "kafka-producer", variable: "STEGO_KAFKA_TOPIC",
			problem: "or STEGO_KAFKA_TOPIC_FILE must be set for the worker mode: it is the topic of every message"}
	}
	return nil
}
{{- end}}
{{- if .Inbox}}

// checkConsumerTopic refuses a worker mode that has no topic for the Kafka inbox of the subscription, at the stage
// service.start.setting.kafka-consumer.STEGO_KAFKA_CONSUMER_TOPIC (ST-SUP-RP14-LC08).
func checkConsumerTopic() error {
	if os.Getenv("STEGO_KAFKA_CONSUMER_TOPIC") == "" && os.Getenv("STEGO_KAFKA_CONSUMER_TOPIC_FILE") == "" {
		return &startSetting{component: "kafka-consumer", variable: "STEGO_KAFKA_CONSUMER_TOPIC",
			problem: "or STEGO_KAFKA_CONSUMER_TOPIC_FILE must be set for the worker mode: it is the topic of the subscription"}
	}
	return nil
}
{{- end}}
{{- if .API}}

// afterSlotsRules are the rules of the destination of the after slots of the collections: idempotent and must land.
var afterSlotsRules = outbox.Rules{Name: api.AfterSlotsDestination, Idempotent: true, MustLand: true}
{{- end}}

// parts are what varies with the declaration of the service, which service.New takes. The outbox worker gets the
// destinations of the service's components{{if .API}} and the after slots of the collections (ST-SUP-RC20-OC34){{end}}.
func parts({{if .API}}afterSlots *api.AfterSlots{{end}}) service.Parts {
	return service.Parts{
		Service: Service, DeclarationVersion: DeclarationVersion, SubjectType: subjectType, TenantClaim: tenantClaim,
		// The open changes with a sync trigger, which the writer marker of each write names (ST-SUP-RC01-OC23).
		SchemaSteps: svcstorage.SchemaSteps, Release: svcstorage.SchemaRelease,
		ProblemType: problemType, ProblemCode: problemCode, TenantConfig: svcstorage.TenantConfig,
		NewQueue:   func(db *sql.DB) (*outbox.Queue, error) { return svcoutbox.NewQueue(db, nil) },
		AuditQueue: func(q *outbox.Queue) (audit.Enqueuer, error) { return svcoutbox.AuditQueue(q) },
		NewAuthz: func(db *sql.DB, provider stegoauthz.Decision, q *outbox.Queue) (*stegoauthz.Runtime, error) {
			return svcauthz.NewRuntime(db, provider, q, nil)
		},
		AuditSettings: svcaudit.Settings,
		// The schema manifest of the tables, which New checks before the service serves (ST-SUP-RC01-OC12).
		Schema: svcstorage.SchemaManifest, OwnerRole: OwnerRole, WorkerRole: WorkerRole, OutboxRelayRole: OutboxRelayRole,
		RelayRole: RelayRole, AuthzSchema: svcauthz.DatabaseSchema, PurgeRole: PurgeRole,
		// The definitions of the authorization schema: only one with the definition tenant has worker relations
		// (ST-SUP-RC35-OC13).
		Definitions: svcauthz.Definitions,
		// The relations of the authorization schema: a relation service of the type tenant makes Provision relate the
		// tenant resource to the service-level resource of the tenant (ST-SUP-RC27-OC18).
		Relations: svcauthz.Relations,
		// The grants of the runtime role that the migration job gives, which the manifest checks on the entity
		// tables (ST-SUP-RP14-LC06).
		Grants: grants,
		Workers: service.WorkerParts{
			NewWorker: func(q *outbox.Queue, config outbox.WorkerConfig, sink audit.Sink) (*outbox.Worker, error) {
				w, err := svcoutbox.NewWorker(q, config, svcoutbox.Ports{AuditSink: sink})
				if err != nil {
					return nil, err
				}
{{- if .API}}
				// An after slot runs only for an active tenant: the message of a retired tenant is parked before its
				// fill (ST-SUP-RC27-OC12).
				if err := w.Register(outbox.Destination{Name: afterSlotsRules.Name, Idempotent: afterSlotsRules.Idempotent,
					MustLand: afterSlotsRules.MustLand, ActiveTenants: true, Handler: func(ctx context.Context, _ *sql.Tx, d outbox.Delivery) error { return afterSlots.Deliver(ctx, d) }}); err != nil {
					return nil, err
				}
{{- end}}
				return w, nil
			},
			NewRelay: svcauthz.NewRelay, WatchInterval: svcauthz.WatchInterval,
			AuditJobs: svcaudit.Jobs, AnchorPeriod: svcaudit.AnchorPeriod, RetentionMonths: svcaudit.RetentionMonths, TenantSchema: tenantSchema,
{{- if .Tickers}}
			// The ticker of each worker with an every trigger, bound to its one fill (ST-SUP-RC35-OC02, ST-SUP-RC35-OC04).
			Tickers: workerrunners.Tickers(workerrunners.BoundFills()),
{{- end}}
{{- if .Consumers}}
			// The one destination handler of each worker with a consumes trigger (ST-SUP-RC35-OC06).
			Consumers: workerrunners.Consumers(workerrunners.BoundFills()),
			// The tables that the consumers write, on which the migration job grants the worker role SELECT, INSERT and
			// UPDATE (ST-SUP-Q141).
			ConsumerTables: workerrunners.ConsumerTables(),
{{- end}}
{{- if .Inbox}}
			// The Kafka inbox of the declared subscription, which writes each record into the outbox for its worker
			// (ST-SUP-RC38-OC01).
			Inbox: subscriptions.Inbox,
{{- end}}
		},
{{- if .Workers}}
		WorkerEntities: workerrunners.Entities(), WorkerNames: workerrunners.Names(),
{{- end}}
{{- if .Commands}}
		Commands: commandhandlers.Entities(),
{{- end}}
{{- if .API}}
		Collections: api.Entities(),
{{- end}}
{{- if .Provisioning}}
		Provisioning: provisioning(),
{{- end}}
{{- if .Sealed}}
		// The readable secret fields, which the controller moves to the first key of the key ring (ST-SUP-RP10-LC46).
		Reseal: svcstorage.ResealColumns,
{{- end}}
{{- if .Ring}}
		// A secret or a pii field: the service does not start without the key ring (ST-SUP-RP14-LC12).
		KeyRing: true,
{{- end}}
{{- if .Seals}}
		// The readable secret fields whose seal step is open, which the controller seals (ST-SUP-RP10-LC50).
		Seal: svcstorage.SealColumns,
{{- end}}
		// The declared rules of the destinations that the outbox worker registers, which the resolver of the api mode
		// applies to a parked message (ST-SUP-RP14-LC10).
		Destinations: destinations(),
	}
}

// destinations gives the declared rules of each destination that the outbox worker of the service registers: those
// of the components{{if .API}} and of the after slots of the collections{{end}}{{if .Consumers}} and of the consumed destinations of the workers{{end}}.
// The runtime adds those of authz itself.
func destinations() []outbox.Rules {
	rules := svcoutbox.Rules()
{{- if .API}}
	rules = append(rules, afterSlotsRules)
{{- end}}
{{- if .Consumers}}
	rules = append(rules, workerrunners.ConsumedRules()...)
{{- end}}
	return rules
}
{{- if .Provisioning}}

// provisioning gives the declared tenant provisioning from the entries of Provision and Retire in the
// operation-to-permission table (ST-SUP-RC27-OC09, ST-SUP-RC29-OC15).
func provisioning() *service.Provisioning {
	p := &service.Provisioning{}
	for _, o := range svcauthz.Operations {
		switch o.Tenant {
		case "provision":
			p.ResourceType, p.Provision, p.ProvisionRoute = o.ResourceType, o.Permission, o.Route
		case "retire":
			p.Retire, p.RetireRoute = o.Permission, o.Route
		case "list":
			p.List = o.Permission
		}
	}
	// The tenant check exempts the route of the tenant list, which answers 404 when the schema declares no
	// list_tenants (ST-SUP-RC27-OC16).
	p.ListRoute = "GET " + strings.TrimSuffix(basePath, "/") + "/stego/tenants"
{{- if .AdminRelation}}
	// Provision gives each first administrator that its body names this relation in the new tenant (ST-SUP-RC27-OC13).
	p.AdminRelation = {{printf "%q" .AdminRelation}}
{{- end}}
	return p
}
{{- end}}

// declaredModes are the modes that the declaration states, in the order api, worker, controller: the binary runs
// these and no other, and all selects them all (ST-GEN-INV26, ST-DECL-EN01).
var declaredModes = modes.Selection{ {{- range $i, $m := .Modes}}{{if $i}}, {{end}}{{printf "%q" $m}}{{end -}} }

// selectModes reads the modes that the process runs from its mode options and STEGO_MODE (ST-SUP-RP09-LC01), and
// refuses a mode that the declaration does not state, naming it and the declared modes.
func selectModes() (modes.Selection, error) {
	parsed, err := modes.Parse(os.Args[1:], os.Getenv)
	if err != nil {
		return nil, err
	}
	names := make([]string, len(declaredModes))
	for i, m := range declaredModes {
		names[i] = string(m)
	}
	for _, m := range parsed {
		if m != modes.All && !slices.Contains(declaredModes, m) {
			return nil, fmt.Errorf("modes: the declaration does not state the mode %s; the modes of the service are %s and all", m, strings.Join(names, ", "))
		}
	}
	var selection modes.Selection
	for _, m := range declaredModes {
		if parsed.Has(m) {
			selection = append(selection, m)
		}
	}
	return selection, nil
}

// Modes gives the modes that the process runs. main.go calls it first, at the stage modes, so a refused mode stops
// the start before the database, and the failure record of a later failure names the modes (ST-GEN-INV26).
func Modes() ([]string, error) {
	selection, err := selectModes()
	if err != nil {
		return nil, err
	}
	names := make([]string, len(selection))
	for i, m := range selection {
		names[i] = string(m)
	}
	return names, nil
}

// NewService builds the runtime of the service through the service runtime, from the settings of the deployment and
// the declaration (ST-SUP-RP14), and makes the command and query handlers, which Routes serves. It reads the settings
// of the worker mode too when the process runs it, so a missing one stops the start at its stage
// (ST-SUP-RP14-LC05).
func NewService(ctx context.Context) (rt *Runtime, err error) {
	selection, err := selectModes()
	if err != nil {
		return nil, err
	}
	// Only the api mode reads the key of the list cursors (core builder 19).
	settings, err := service.ReadModeSettings(declared, selection.Has(modes.API))
	if err != nil {
		return nil, err
	}
{{- if .Ring}}
	// The key ring of the secret and pii fields, which each mode of this process reads and the migration job does not
	// (ST-SUP-RP14-LC12); it also keys the fingerprints of the idempotency keys and seals their stored answers
	// (ST-SUP-RP16-LC05, ST-SUP-RP07-LC13).
	var ring *sealed.Ring
	if ring, err = service.ReadKeyRing(); err != nil {
		return nil, err
	}
	settings.Ring = ring
{{- end}}
	var workerSettings service.WorkerSettings
	if selection.Has(modes.Worker) {
		if workerSettings, err = service.ReadWorkerSettings(true); err != nil {
			return nil, err
		}
{{- if .KafkaTopic}}
		if err = checkKafkaTopic(); err != nil {
			return nil, err
		}
{{- end}}
{{- if .Inbox}}
		if err = checkConsumerTopic(); err != nil {
			return nil, err
		}
{{- end}}
	}
{{- if .API}}
	afterSlots := api.NewAfterSlots()
	svc, err := service.New(ctx, settings, parts(afterSlots))
	if err != nil {
		return nil, err
	}
	rt = &Runtime{svc: svc, routes: http.NewServeMux(), selection: selection, workerSettings: workerSettings, afterSlots: afterSlots}
	if err = afterSlots.Meter(svc.Telemetry().MeterProvider()); err != nil {
		_ = rt.Close()
		return nil, err
	}
{{- else}}
	svc, err := service.New(ctx, settings, parts())
	if err != nil {
		return nil, err
	}
	rt = &Runtime{svc: svc, routes: http.NewServeMux(), selection: selection, workerSettings: workerSettings}
{{- end}}
	defer func() {
		if err != nil {
			_ = rt.Close()
			rt = nil
		}
	}()
{{- if .Commands}}
	if err = commandhandlers.Register(rt.routes, svc.Commands(), commandhandlers.BoundFills(), commandhandlers.Options{Retention: retention}); err != nil {
		return nil, err
	}
{{- end}}
{{- if .Queries}}
	queries, err := queryserve.New(queryserve.Config{Runtime: svc.Queries(), Verifier: svc.Verifier(), Probes: svc.Probes(), SubjectType: subjectType})
	if err != nil {
		return nil, err
	}
	queries.Routes(rt.routes)
{{- end}}
{{- if or .API .Commands}}
	// The revocation status route, which answers the state of a write's revocation to its writer alone, comes from
	// its entry of the operation-to-permission table only (ST-SUP-RC29-OC17, ST-SUP-RC29-OC18).
	for _, o := range svcauthz.Operations {
		if o.Writer {
			rt.routes.Handle(o.Route, command.ServeRevocationStatus({{if .API}}svc.Collections(){{else}}svc.Commands(){{end}}, subjectType))
		}
	}
{{- end}}
	// The parked-message list and resolve of an operator, behind authentication and in the api mode only
	// (ST-SUP-RP14-LC09, ST-SUP-RP14-LC10).
	svc.RegisterParked(rt.routes, basePath, selection)
{{- if .Provisioning}}
	// Provision and Retire, which the service serves itself, come from their entries of the operation-to-permission
	// table only (ST-SUP-RC27-OC09, ST-SUP-RC29-OC15).
	provision, retire := svc.TenantRoutes()
	for _, o := range svcauthz.Operations {
		switch o.Tenant {
		case "provision":
			rt.routes.Handle(o.Route, provision)
		case "retire":
			rt.routes.Handle(o.Route, retire)
		case "list":
			// The tenant list of the operator (ST-SUP-RC27-OC16).
			if list := svc.TenantList(); list != nil {
				rt.routes.Handle(o.Route, list)
			}
		}
	}
{{- end}}
	return rt, nil
}

// basePath is the base path of the service, under which the runtime serves the parked-message routes.
const basePath = {{printf "%q" .BasePath}}

// retention is how long a completed idempotency key is kept: the declared retention, or zero for the runtime's
// default.
const retention = {{if .Idempotency}}svcidempotency.Retention{{else}}0{{end}}

// Middleware verifies the bearer token of each request before next, which ends in router, the main router of
// main.go; a request whose token the verifier refuses is answered 401 and reaches no handler. For a service that
// declares its provisioning, the tenant check exempts a request only when router matches it to the pattern of
// Provision or of Retire (ST-SUP-RC27-OC11). A process that does not run the api mode serves no request of the
// service: each is answered 503, and only the probes answer (ST-SUP-RP09-LC01).
func (rt *Runtime) Middleware(router *http.ServeMux, next http.Handler) http.Handler {
	if !rt.selection.Has(modes.API) {
		return http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
			http.Error(w, "this process does not run the api mode", http.StatusServiceUnavailable)
		})
	}
	return rt.svc.RoutedMiddleware(router, next)
}

// ShutdownBound bounds the shutdown of the workers after the process is told to stop.
const ShutdownBound = 30 * time.Second

// Run starts the workers of the selected modes through the service runtime (ST-SUP-RP14-LC04): in the worker mode
// the outbox worker on the worker role, the relay on the relay role and the relay's watch; in the controller mode the
// audit jobs under the controller lease. It returns when ctx ends, after the workers stopped within ShutdownBound.
func (rt *Runtime) Run(ctx context.Context) error {
	workerSettings := rt.workerSettings
	if rt.selection.Has(modes.Worker) {
		// The audit-sink port binds the HTTPS endpoint of the settings, or else the default table in the service
		// database (ST-SUP-RP05-LC15, ST-SUP-RP05-LC16).
		slog.InfoContext(ctx, "the audit sink", "port", audit.SinkDestination, "https", workerSettings.AuditSink.HTTPS())
	}
	// The api mode starts no component of the service runtime: its HTTP server is main's, and the health check
	// answers its readiness. The workers run for the worker and controller modes.
	var background modes.Selection
	for _, m := range []modes.Mode{modes.Worker, modes.Controller} {
		if rt.selection.Has(m) {
			background = append(background, m)
		}
	}
	if len(background) == 0 {
		<-ctx.Done()
		return ctx.Err()
	}
	workers, err := rt.svc.Start(ctx, service.StartConfig{Selection: background, Workers: workerSettings})
	if err != nil {
		return err
	}
	rt.mu.Lock()
	rt.workers = workers
	rt.mu.Unlock()
	<-ctx.Done()
	stopCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), ShutdownBound)
	defer cancel()
	if err := workers.Shutdown(stopCtx); err != nil {
		return err
	}
	return ctx.Err()
}

// Readiness answers the readiness of the worker and controller modes that the process runs, and names each worker
// that stopped and each job that is not healthy (ST-SUP-RP09-LC05); before Run started the workers they are not
// ready. A process that runs neither mode is ready here.
func (rt *Runtime) Readiness() http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		rt.mu.Lock()
		workers := rt.workers
		rt.mu.Unlock()
		w.Header().Set("Content-Type", "text/plain; charset=utf-8")
		var err error
		switch {
		case workers != nil:
			err = workers.Ready(r.Context())
		case rt.selection.Has(modes.Worker) || rt.selection.Has(modes.Controller):
			err = errors.New("the workers have not started")
		}
		if err != nil {
			w.WriteHeader(http.StatusServiceUnavailable)
			_, _ = w.Write([]byte(err.Error() + "\n"))
			return
		}
		_, _ = w.Write([]byte("ready\n"))
	})
}

// tenantSchema is the schema of the tenant list stego_tenants that the migration job makes and the audit jobs visit
// (ST-SUP-RP04-LC07).
const tenantSchema = "public"

// Routes serves the declared commands and queries, each at its route, the revocation status route and, in the api
// mode, the parked-message routes.
func (rt *Runtime) Routes() http.Handler { return rt.routes }

// Service gives the runtime library objects of the running service, on which the gRPC application serves the
// methods of the declared commands and queries (ST-SUP-RC07-OC19).
func (rt *Runtime) Service() *service.Service { return rt.svc }

// Retention is how long a completed idempotency key is kept, for the command handlers of the gRPC application.
func (rt *Runtime) Retention() time.Duration { return retention }

// ServesAPI tells whether the process runs the api mode: only then does the gRPC application serve
// (ST-SUP-RP09-LC01).
func (rt *Runtime) ServesAPI() bool { return rt.selection.Has(modes.API) }
{{- if .API}}

// CollectionRuntime gives the Runtime of the collection handlers: their own command runtime, the query runtime and
// the probes.
func (rt *Runtime) CollectionRuntime() *api.Runtime {
	return &api.Runtime{Commands: rt.svc.Collections(), Queries: rt.svc.Queries(), Probes: rt.svc.Probes(), Retention: retention,
		AfterSlots: rt.afterSlots}
}
{{- end}}

// Close releases what NewService opened.
func (rt *Runtime) Close() error { return rt.svc.Close() }

// Migrate is the migration job of the service (tenant.MigrationJob), which the service runtime runs in its fixed
// order on one connection (ST-SUP-RP14-LC03): the ledger check and the ledger of the PostgreSQL adapter with the
// tenant list of the tenant runtime, the schema of the authorization component, the outbox, audit, idempotency and authorization migrations of the runtime library,
// the grants of the runtime role, the audit partitions, the check of the schema manifest of the declared parts, which
// a start only alerts, and the backfills.
func Migrate(ctx context.Context) error {
	settings, err := service.ReadMigrationSettings()
	if err != nil {
		return &service.StepError{Step: service.StepSettings, Err: err}
	}
	queueText, err := svcoutbox.Migration(OutboxRelayRole, RuntimeRole, WorkerRole)
	if err != nil {
		return &service.StepError{Step: service.StepSettings, Err: err}
	}
{{- if .Inbox}}
	// The table of the refused records of the Kafka inbox (ST-SUP-RP01-LC37).
	inboxText, err := subscriptions.Migration(WorkerRole)
	if err != nil {
		return &service.StepError{Step: service.StepSettings, Err: err}
	}
{{- end}}
	auditText, err := svcaudit.Migration(RuntimeRole)
	if err != nil {
		return &service.StepError{Step: service.StepSettings, Err: err}
	}
	authzText, err := svcauthz.Migration(RuntimeRole, RelayRole, OutboxRelayRole, WorkerRole)
	if err != nil {
		return &service.StepError{Step: service.StepSettings, Err: err}
	}
	// The backfill of each open rename, which the job runs last, before the rollout (ST-GEN-UC13).
	backfills, err := service.CopyBackfills(svcstorage.BackfillCopies, tenantSchema)
	if err != nil {
		return &service.StepError{Step: service.StepSettings, Err: err}
	}
	// The job refuses at its end a database that does not hold the schema manifest of the parts that New checks
	// (decision on finding F10 of the schema-change research, owner, 2026-11-13).
	declaredParts := parts({{if .API}}nil{{end}})
	return service.Migrate(ctx, settings, service.Migration{
		OwnerRole: OwnerRole, RuntimeRole: RuntimeRole, WorkerRole: WorkerRole, PurgeRole: PurgeRole, OutboxRelayRole: OutboxRelayRole, TenantConfig: svcstorage.TenantConfig,
		LedgerCheck: func(ctx context.Context, conn *sql.Conn) error { return svcstorage.CheckLedger(ctx, conn) },
		Ledger:      func(ctx context.Context, conn *sql.Conn) error { return svcstorage.Migrate(ctx, conn) },
		Outbox:      queueText, Audit: auditText, Authorization: authzText,
		WriteSchema: func(ctx context.Context, conn grpc.ClientConnInterface) error { return svcauthz.WriteSchema(ctx, conn) },
		Definitions: svcauthz.Definitions,
		Grants:      grants, TenantSchema: tenantSchema,
		Service:     Service, Backfills: backfills, Parts: &declaredParts,
{{- if .Inbox}}
		Inbox: inboxText,
{{- end}}
{{- if .Workers}}
		// The lease row of each single worker (ST-SUP-RC35-OC05).
		WorkerLeases: workerrunners.Leases(),
{{- end}}
{{- if .Seals}}
		// The backfill lease of each open seal change, under which the controller seals (ST-SUP-RP10-LC50).
		SealLeases: []string{ {{- range $i, $c := .Seals}}{{if $i}}, {{end}}{{printf "%q" $c}}{{end -}} },
{{- end}}
	})
}

// MigrationStage gives the stage of a failure of Migrate, such as migrate.ledger_check, which names the step and no
// error text, for the failure record of the process.
func MigrationStage(err error) string { return service.Stage(err) }
