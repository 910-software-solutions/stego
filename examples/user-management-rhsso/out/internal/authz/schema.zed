definition user {}

// The service-level resource that an operator provisions and retires tenants on, whose ID is the service name.
definition service {
	relation operator: user
	permission provision = operator
	permission retire = operator
}

definition organization {
	relation owner: user
	relation viewer: user
	permission view = owner + viewer
	permission edit = owner
}

definition member {
	relation organization: organization
	relation owner: user
	permission view = owner + organization->view
	// The routes of a member name its organization, and decide only on the member (ST-SUP-RC20-OC24): an owner of a
	// member who may not view its organization may not change it.
	permission edit = (owner + organization->edit) & organization->view
}

definition org_setting {
	relation organization: organization
	permission view = organization->view
	permission edit = organization->edit
}

definition stego_floor {
	relation marker: stego_floor
}
