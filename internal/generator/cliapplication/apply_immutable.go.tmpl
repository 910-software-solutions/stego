func validateImmutableApply(r ApplyResource) error {
 if len(r.ImmutableIdentity)==0{return nil}
 if len(r.ImmutableIdentity)>8||len(r.PatchFields)!=0{return errors.New("invalid immutable apply definition")}
 fields:=map[string]Field{};for _,f:=range r.CreateFields{fields[f.Key]=f}
 seen:=map[string]bool{}
 for _,key:=range r.ImmutableIdentity{
  f,ok:=fields[key]
  if !ok||seen[key]||f.Type!="string"||!f.Required||f.Nullable{return errors.New("immutable identity requires unique required string fields")}
  seen[key]=true
 }
 return nil
}
func immutableIdentity(r ApplyResource,body map[string]json.RawMessage)(map[string]string,error){
 if err:=applyFields(r.CreateFields,body,true);err!=nil{return nil,fmt.Errorf("%s: %w",r.Kind,err)}
 values:=map[string]string{}
 for _,key:=range r.ImmutableIdentity{
  var value string
  if json.Unmarshal(body[key],&value)!=nil||len(value)>256||strings.TrimSpace(value)==""{return nil,errors.New("invalid immutable apply identity")}
  values[key]=value
 }
 return values,nil
}
func immutableMatches(p *applyPlan,row map[string]json.RawMessage)error{
 fields:=map[string]Field{};for _,f:=range p.resource.CreateFields{fields[f.Key]=f}
 for key,want:=range p.body{
  got,ok:=row[key]
  if !ok||!fieldValue(fields[key],got){return errors.New("immutable apply resource differs from the requested fields")}
  if !equalApplyValue(fields[key],want,got){return errors.New("immutable apply resource differs from the requested fields")}
 }
 return nil
}
func equalApplyScalar[T comparable](left,right []byte)bool{
 var a,b T
 return json.Unmarshal(left,&a)==nil&&json.Unmarshal(right,&b)==nil&&a==b
}
func equalApplyValue(field Field,left,right []byte)bool{
 leftNull:=bytes.Equal(bytes.TrimSpace(left),[]byte("null"));rightNull:=bytes.Equal(bytes.TrimSpace(right),[]byte("null"))
 if leftNull||rightNull{return leftNull&&rightNull}
 switch field.Type{
 case "string":return equalApplyScalar[string](left,right)
 case "integer":return equalApplyScalar[int64](left,right)
 case "boolean":return equalApplyScalar[bool](left,right)
 case "string-list":var a,b []string;return json.Unmarshal(left,&a)==nil&&json.Unmarshal(right,&b)==nil&&slices.Equal(a,b)
 }
 return false
}

// applyLookupPages bounds the pages of one lookup. A list page can hold fewer values than its size, or none, and still
// give a next cursor, so the lookup follows next until the list ends, it finds two values, or it reaches the bound.
const applyLookupPages=32
// applyLookupTimeout bounds the time of one lookup, all its pages together, below the 15 s of each request times
// applyLookupPages. Only the tests of this package change it.
var applyLookupTimeout=60*time.Second
func applyLookup(ctx context.Context,transport *client.Client,headers http.Header,p *applyPlan)(map[string]json.RawMessage,error){
 lookup,cancel:=context.WithTimeout(ctx,applyLookupTimeout);defer cancel()
 get:=func(route string)(client.Response,error){
  response,err:=transport.Do(lookup,"GET",route,headers,nil)
  if err!=nil&&lookup.Err()!=nil&&ctx.Err()==nil{return response,errors.New("apply lookup exceeded its time limit; select metadata.id")}
  return response,err
 }
 if p.id!=""{
  response,err:=get(p.resource.Path+"/"+url.PathEscape(p.id));if err!=nil{return nil,err}
  if response.StatusCode!=200{return nil,fmt.Errorf("apply lookup failed (HTTP %d)",response.StatusCode)}
  row,err:=object(response.Body);if err!=nil{return nil,errors.New("invalid apply lookup response")}
  return applyLookupRow(p,row)
 }
 search:="name = '"+strings.ReplaceAll(p.name,"'","''")+"'"
 if len(p.resource.ImmutableIdentity)>0{
  values,err:=immutableIdentity(p.resource,p.body);if err!=nil{return nil,err}
  keys:=append([]string(nil),p.resource.ImmutableIdentity...);sort.Strings(keys)
  parts:=make([]string,0,len(keys));for _,key:=range keys{parts=append(parts,key+" = '"+strings.ReplaceAll(values[key],"'","''")+"'")};search=strings.Join(parts," and ")
 }
 var found []json.RawMessage;cursor:=""
 for page:=0;;page++{
  if page==applyLookupPages{return nil,errors.New("apply lookup did not end; select metadata.id")}
  query:=url.Values{"pageSize":{"2"},"search":{search}};if cursor!=""{query.Set("cursor",cursor)}
  response,err:=get(p.resource.Path+"?"+query.Encode());if err!=nil{return nil,err}
  if response.StatusCode!=200{return nil,fmt.Errorf("apply lookup failed (HTTP %d)",response.StatusCode)}
  list,err:=object(response.Body);if err!=nil{return nil,errors.New("invalid apply list response")}
  var items []json.RawMessage
  if json.Unmarshal(list["items"],&items)!=nil||items==nil{return nil,errors.New("invalid apply list response")}
  if raw,ok:=list["size"];ok{var size *int64;if json.Unmarshal(raw,&size)!=nil||size==nil||*size!=int64(len(items)){return nil,errors.New("inconsistent apply list response")}}
  found=append(found,items...)
  if len(found)>1{return nil,errors.New("apply identity is ambiguous; select metadata.id")}
  // A list that gives a total, as a service that is not generated can, must give all of its values: a total larger
  // than the values found at the end of the list tells of a value that the lookup did not see.
  raw,ok:=list["next"];if !ok{if raw,ok:=list["total"];ok{var total *int64;if json.Unmarshal(raw,&total)!=nil||total==nil||*total<0||*total>int64(len(found)){return nil,errors.New("inconsistent apply list response")}};break}
  var next string
  if json.Unmarshal(raw,&next)!=nil||next==""||!plainText(next,4096){return nil,errors.New("invalid apply list response")}
  cursor=next
 }
 if len(found)==0{return nil,nil}
 row,err:=object(found[0]);if err!=nil{return nil,errors.New("invalid apply resource response")}
 if len(p.resource.ImmutableIdentity)==0{var name string;if json.Unmarshal(row["name"],&name)!=nil||name!=p.name{return nil,errors.New("invalid apply resource identity")}}
 return applyLookupRow(p,row)
}
// applyLookupRow checks the identity of the row that a lookup found.
func applyLookupRow(p *applyPlan,row map[string]json.RawMessage)(map[string]json.RawMessage,error){
 var id string
 if json.Unmarshal(row["id"],&id)!=nil||!identifier.MatchString(id)||(p.id!=""&&p.id!=id){return nil,errors.New("invalid apply resource identity")}
 if len(p.resource.ImmutableIdentity)>0{if err:=immutableMatches(p,row);err!=nil{return nil,err}}
 return row,nil
}
