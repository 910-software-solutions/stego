definition user {}

// The service-level resource that an operator provisions and retires tenants on, whose ID is the service name.
definition service {
	relation operator: user
	permission provision = operator
	permission retire = operator
	permission list_tenants = operator
}

definition organization {
	relation owner: user
	relation viewer: user
	permission view = owner + viewer
	permission edit = owner
}

definition member {
	relation organization: organization
	relation owner: user
	// The routes of a member name its organization, and decide only on the member (ST-SUP-RC20-OC24). A member is
	// seen only through its organization, and its owner may change it only while the owner may view the
	// organization, as with an earlier STEGO (ST-SUP-Q156). The view is (owner + organization->view) &
	// organization->view written short.
	permission view = organization->view
	permission edit = (owner + organization->edit) & organization->view
}

definition org_setting {
	relation organization: organization
	permission view = organization->view
	permission edit = organization->edit
}

// The operators who resolve the parked messages of an outbox destination (ST-SUP-RC29-OC20).
definition outbox_destination {
	relation operator: user
	permission resolve = operator
}
